                        <l10n:LocalizedTextBlock Grid.Row="2" Text="{l10n:Tr 66603AA010BD408F}"
                                   Foreground="#64748B" FontSize="11" Margin="0,10,0,0"/>
                    </Grid>
                </l10n:LocalizedTabItem>
                <l10n:LocalizedTabItem Header="{l10n:Tr 5E61760736C351F0}">
                    <Grid Margin="6,12,6,6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
