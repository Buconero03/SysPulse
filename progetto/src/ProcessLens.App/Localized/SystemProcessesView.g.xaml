<UserControl x:Class="ProcessLens.App.SystemProcessesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l10n="clr-namespace:ProcessLens.App"
 xmlns:local="clr-namespace:ProcessLens.App">
 <UserControl.Resources>
  <Style x:Key="SystemAction" TargetType="Button">
   <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,8"/>
   <Setter Property="Margin" Value="0,0,8,6"/>
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#124E87"/>
   <Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
    <l10n:LocalizedTextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
   </DataTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SystemCell" TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="9,8"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="SystemColumnHeader" TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/>
   <Setter Property="Padding" Value="9,10"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
    <l10n:LocalizedTextBlock Text="{Binding}" TextWrapping="Wrap"/>
   </DataTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SystemRow" TargetType="DataGridRow">
   <Setter Property="BorderThickness" Value="0"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EFF6FF"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DBEAFE"/><Setter Property="Foreground" Value="#123B63"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="SystemGridCell" TargetType="DataGridCell">
   <Setter Property="BorderThickness" Value="0"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DBEAFE"/><Setter Property="Foreground" Value="#123B63"/></Trigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid Background="#F5F6F8" Margin="0,0,0,2">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="110"/><RowDefinition Height="9"/><RowDefinition Height="1.15*" MinHeight="150"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,10">
  <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
  <StackPanel>
  <StackPanel Margin="14,12,14,4">
   <l10n:LocalizedTextBlock Text="{l10n:Tr A9C70019C65002B7}" FontSize="21" FontWeight="SemiBold"/>
   <local:SelectableText Text="{l10n:Tr 2E2444D377EE0318}"
       TextWrapping="Wrap" Margin="0,5,0,0"/>
  </StackPanel>
  <WrapPanel Margin="12,8,12,2">
   <l10n:LocalizedButton x:Name="RefreshSystemButton" Content="{l10n:Tr CB98923A2B49DFEF}" Style="{StaticResource SystemAction}" Background="#124E87" Foreground="White" Click="RefreshSystem_Click"/>
   <l10n:LocalizedButton x:Name="CopySystemButton" Content="{l10n:Tr 8B024025413ABBB5}" Style="{StaticResource SystemAction}" IsEnabled="False" Click="CopySystem_Click"/>
   <ComboBox x:Name="SystemScopeBox" SelectedIndex="0" Width="210" MinHeight="36" Padding="7,5" Margin="0,0,12,6" SelectionChanged="Scope_Changed" ToolTip="{l10n:Tr 9F9854EB96A8DF0C}">
    <l10n:LocalizedComboBoxItem Content="{l10n:Tr 010BA267C8825923}"/><l10n:LocalizedComboBoxItem Content="{l10n:Tr C7BF7C1130F22541}"/>
    <l10n:LocalizedComboBoxItem Content="{l10n:Tr 4E140479A51EE4C9}"/><l10n:LocalizedComboBoxItem Content="{l10n:Tr E08BC21EB694A15B}"/>
    <l10n:LocalizedComboBoxItem Content="{l10n:Tr E1D158129A3173A9}"/><l10n:LocalizedComboBoxItem Content="{l10n:Tr F59C55742CB51CC1}"/>
   </ComboBox>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
   <l10n:LocalizedTextBlock Text="{l10n:Tr 15910E265A5D3CFC}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#667085"/>
   <l10n:LocalizedTextBox x:Name="SystemSearchBox" Width="180" MinHeight="36" Padding="7,5" MaxLength="128" VerticalContentAlignment="Center"
       ToolTip="{l10n:Tr 9CC2F8ADC53D73B6}" TextChanged="Search_Changed"/>
   </StackPanel>
  </WrapPanel>
  <StackPanel Margin="12,4,12,8">
   <local:SelectableText x:Name="SystemStatusText" Text="{l10n:Tr 92BFF6550BA78ACE}" TextWrapping="Wrap" FontWeight="SemiBold"/>
   <local:SelectableText x:Name="SystemCoverageText" Text="{l10n:Tr B25EEDAAF10909FB}" TextWrapping="Wrap" Margin="0,5,0,0"/>
   <l10n:LocalizedExpander Header="{l10n:Tr 5A668D79257281AD}" Margin="0,8,0,0">
    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,8,0,0">
   <local:SelectableText Text="{l10n:Tr 6868002242C5E8D5}"
       TextWrapping="Wrap" Foreground="#667085" Margin="0,4,0,0"/>

      <local:SelectableText x:Name="SystemMemoryText" Text="{l10n:Tr 00EA2D2EBEF27EE1}" TextWrapping="Wrap"/>
      <local:SelectableText x:Name="SystemSourceText" Text="{l10n:Tr FDE9259BC25ABADD}" TextWrapping="Wrap" Margin="0,7,0,0"/>
      <local:SelectableText Text="{l10n:Tr 96B765C1F9865951}"
          TextWrapping="Wrap" Margin="0,7,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </l10n:LocalizedExpander>
  </StackPanel>
  </StackPanel>
  </ScrollViewer>
  </Border>
  <DataGrid x:Name="SystemProcessesTable" Grid.Row="1" Margin="0" IsReadOnly="True" AutoGenerateColumns="False"
      CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"
      VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Single" SelectionUnit="FullRow"
      local:GridCopySupport.Enabled="True" MinRowHeight="40" FontSize="13" SelectionChanged="SystemSelection_Changed"
      Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC" AlternationCount="2"
      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#D8E1EC" BorderThickness="1"
      ColumnHeaderStyle="{StaticResource SystemColumnHeader}" RowStyle="{StaticResource SystemRow}" CellStyle="{StaticResource SystemGridCell}">
   <DataGrid.Columns>
    <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 024DC204D7BA77A8}" Binding="{Binding Category, Mode=OneWay}" Width="140" ElementStyle="{StaticResource SystemCell}"/>
    <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 75926F8261AD70EB}" Binding="{Binding Name, Mode=OneWay}" Width="170" ElementStyle="{StaticResource SystemCell}"/>
    <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr F674A8E66EE9B052}" Binding="{Binding Function, Mode=OneWay}" Width="*" MinWidth="180" ElementStyle="{StaticResource SystemCell}"/>
    <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 0B2C701D9886FDA0}" Binding="{Binding Count, Mode=OneWay}" Width="65" ElementStyle="{StaticResource SystemCell}"/>
    <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 9A71356A9F2AA350}" Binding="{Binding Resident, Mode=OneWay}" Width="120" ElementStyle="{StaticResource SystemCell}"/>
    <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 18BFFEF3CE9F99FF}" Binding="{Binding Identity, Mode=OneWay}" Width="185" ElementStyle="{StaticResource SystemCell}"/>
   </DataGrid.Columns>
  </DataGrid>
  <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows"
      ResizeBehavior="PreviousAndNext" Background="#CBD5E1" Margin="0,3" ShowsPreview="True" ToolTip="{l10n:Tr 8D87327489118CDE}"/>
  <Border Grid.Row="3" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,12">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <l10n:LocalizedTextBlock Text="{l10n:Tr EB8B7D3ABB5B1D3D}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <WrapPanel Grid.Row="1" Margin="0,0,0,8">
    <l10n:LocalizedTextBlock Text="{l10n:Tr 4CD4013CA3B997DE}" VerticalAlignment="Center" Margin="0,0,10,6" Foreground="#667085"/>
    <ComboBox x:Name="SystemInstancesBox" SelectionChanged="SystemInstance_Changed" IsEnabled="False"
        MinWidth="180" Width="340" MinHeight="36" Padding="7,5" Margin="0,0,10,6">
     <ComboBox.ItemTemplate><DataTemplate><l10n:LocalizedTextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <l10n:LocalizedButton x:Name="AnalyzeSystemButton" Content="{l10n:Tr C7B3DA7139AF82C0}" Style="{StaticResource SystemAction}"
        IsEnabled="False" Click="AnalyzeSystem_Click"/>
   </WrapPanel>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,2,8,0">
    <local:SelectableText x:Name="SystemSelectionText" Text="{l10n:Tr 70FC35161D2217E2}"
        FontSize="13" TextWrapping="Wrap" Foreground="#334155"/>
   </ScrollViewer>
  </Grid>
  </Border>
 </Grid>
</UserControl>
