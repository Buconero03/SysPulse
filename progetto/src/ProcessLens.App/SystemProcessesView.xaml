<UserControl x:Class="ProcessLens.App.SystemProcessesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ProcessLens.App">
 <UserControl.Resources>
  <Style x:Key="SystemAction" TargetType="Button">
   <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,8"/>
   <Setter Property="Margin" Value="0,0,8,6"/>
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#124E87"/>
   <Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
   </DataTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SystemCell" TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="9,8"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="SystemColumnHeader" TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#475569"/>
   <Setter Property="Padding" Value="9,10"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
   </DataTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SystemRow" TargetType="DataGridRow">
   <Setter Property="BorderThickness" Value="0"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EFF6FF"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DBEAFE"/><Setter Property="Foreground" Value="#123B63"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="SystemGridCell" TargetType="DataGridCell">
   <Setter Property="BorderThickness" Value="0"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DBEAFE"/><Setter Property="Foreground" Value="#123B63"/></Trigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid Background="#F5F6F8" Margin="0,0,0,2">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="110"/><RowDefinition Height="9"/><RowDefinition Height="1.15*" MinHeight="150"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,10">
  <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
  <StackPanel>
  <StackPanel Margin="14,12,14,4">
   <TextBlock Text="Componenti di Windows" FontSize="21" FontWeight="SemiBold"/>
   <local:SelectableText Text="Kernel, sessioni, servizi e sicurezza. Catalogo mirato, non un elenco completo di Windows. R22"
       TextWrapping="Wrap" Margin="0,5,0,0"/>
  </StackPanel>
  <WrapPanel Margin="12,8,12,2">
   <Button x:Name="RefreshSystemButton" Content="Aggiorna campione" Style="{StaticResource SystemAction}" Background="#124E87" Foreground="White" Click="RefreshSystem_Click"/>
   <Button x:Name="CopySystemButton" Content="Copia rapporto" Style="{StaticResource SystemAction}" IsEnabled="False" Click="CopySystem_Click"/>
   <ComboBox x:Name="SystemScopeBox" SelectedIndex="0" Width="210" MinHeight="36" Padding="7,5" Margin="0,0,12,6" SelectionChanged="Scope_Changed" ToolTip="Filtra per area di Windows">
    <ComboBoxItem Content="Tutti i componenti"/><ComboBoxItem Content="Kernel e memoria"/>
    <ComboBoxItem Content="Avvio e sessioni"/><ComboBoxItem Content="Servizi"/>
    <ComboBoxItem Content="Sicurezza"/><ComboBoxItem Content="Desktop e console"/>
   </ComboBox>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
   <TextBlock Text="Cerca" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#667085"/>
   <TextBox x:Name="SystemSearchBox" Width="180" MinHeight="36" Padding="7,5" MaxLength="128" VerticalContentAlignment="Center"
       ToolTip="Cerca componente o funzione; per PID usa solo cifre. I programmi comuni restano nella scheda Processi." TextChanged="Search_Changed"/>
   </StackPanel>
  </WrapPanel>
  <StackPanel Margin="12,4,12,8">
   <local:SelectableText x:Name="SystemStatusText" Text="Premi Aggiorna campione. Una riga per componente; le istanze sono riunite." TextWrapping="Wrap" FontWeight="SemiBold"/>
   <local:SelectableText x:Name="SystemCoverageText" Text="Copertura: N/D" TextWrapping="Wrap" Margin="0,5,0,0"/>
   <Expander Header="Memoria del kernel, fonte e copertura" Margin="0,8,0,0">
    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,8,0,0">
   <local:SelectableText Text="Una riga riunisce più istanze: selezionala per vedere ogni PID. I conteggi includono solo le voci restituite dalla fonte, anche con dettagli N/D. La firma digitale non è verificata."
       TextWrapping="Wrap" Foreground="#667085" Margin="0,4,0,0"/>

      <local:SelectableText x:Name="SystemMemoryText" Text="Memoria: N/D" TextWrapping="Wrap"/>
      <local:SelectableText x:Name="SystemSourceText" Text="Nessuna lettura eseguita." TextWrapping="Wrap" Margin="0,7,0,0"/>
      <local:SelectableText Text="La lettura non cattura eventi: per avvii e uscite usa Guardian. Processi brevi e voci protette possono mancare. Driver, interrupt e DPC non sono processi separati. Nessun nuovo monitor in background."
          TextWrapping="Wrap" Margin="0,7,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </Expander>
  </StackPanel>
  </StackPanel>
  </ScrollViewer>
  </Border>
  <DataGrid x:Name="SystemProcessesTable" Grid.Row="1" Margin="0" IsReadOnly="True" AutoGenerateColumns="False"
      CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"
      VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Single" SelectionUnit="FullRow"
      local:GridCopySupport.Enabled="True" MinRowHeight="40" FontSize="13" SelectionChanged="SystemSelection_Changed"
      Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC" AlternationCount="2"
      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#D8E1EC" BorderThickness="1"
      ColumnHeaderStyle="{StaticResource SystemColumnHeader}" RowStyle="{StaticResource SystemRow}" CellStyle="{StaticResource SystemGridCell}">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Area" Binding="{Binding Category, Mode=OneWay}" Width="140" ElementStyle="{StaticResource SystemCell}"/>
    <DataGridTextColumn Header="Componente" Binding="{Binding Name, Mode=OneWay}" Width="170" ElementStyle="{StaticResource SystemCell}"/>
    <DataGridTextColumn Header="Funzione" Binding="{Binding Function, Mode=OneWay}" Width="*" MinWidth="180" ElementStyle="{StaticResource SystemCell}"/>
    <DataGridTextColumn Header="Istanze" Binding="{Binding Count, Mode=OneWay}" Width="65" ElementStyle="{StaticResource SystemCell}"/>
    <DataGridTextColumn Header="WS max letto" Binding="{Binding Resident, Mode=OneWay}" Width="120" ElementStyle="{StaticResource SystemCell}"/>
    <DataGridTextColumn Header="Identificazione" Binding="{Binding Identity, Mode=OneWay}" Width="185" ElementStyle="{StaticResource SystemCell}"/>
   </DataGrid.Columns>
  </DataGrid>
  <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows"
      ResizeBehavior="PreviousAndNext" Background="#CBD5E1" Margin="0,3" ShowsPreview="True" ToolTip="Trascina per dare più spazio alla tabella o ai dettagli"/>
  <Border Grid.Row="3" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,12">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="Dettagli del componente" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <WrapPanel Grid.Row="1" Margin="0,0,0,8">
    <TextBlock Text="Istanza da approfondire" VerticalAlignment="Center" Margin="0,0,10,6" Foreground="#667085"/>
    <ComboBox x:Name="SystemInstancesBox" DisplayMemberPath="Label" SelectionChanged="SystemInstance_Changed" IsEnabled="False"
        MinWidth="180" Width="340" MinHeight="36" Padding="7,5" Margin="0,0,10,6"/>
    <Button x:Name="AnalyzeSystemButton" Content="Analizza PID selezionato" Style="{StaticResource SystemAction}"
        IsEnabled="False" Click="AnalyzeSystem_Click"/>
   </WrapPanel>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,2,8,0">
    <local:SelectableText x:Name="SystemSelectionText" Text="Seleziona un componente per leggere funzione e dati del campione."
        FontSize="13" TextWrapping="Wrap" Foreground="#334155"/>
   </ScrollViewer>
  </Grid>
  </Border>
 </Grid>
</UserControl>
