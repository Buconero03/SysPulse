<Window x:Class="ProcessLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProcessLens.App"
        Title="ProcessLens"
        Width="1180"
        Height="800"
        MinWidth="950"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        Foreground="#202124">

    <Window.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E5E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SelectableSectionLabel" TargetType="local:SelectableText">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="DetailCard" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Text content wraps inside the native WPF button without a fixed height. -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D9DDE3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProcessListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ProcessItem_RightMouseDown"/>
            <EventSetter Event="Loaded" Handler="ProcessItem_Loaded"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#C9D2DE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EAF2FF"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#77A7E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ServiceListItemStyle" TargetType="ListViewItem">
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ServiceItem_RightMouseDown"/>
            <EventSetter Event="MouseDoubleClick" Handler="ServiceItem_MouseDoubleClick"/>
            <EventSetter Event="KeyDown" Handler="ServiceItem_KeyDown"/>
            <EventSetter Event="Loaded" Handler="ServiceItem_Loaded"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ServiceItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ServiceItemBorder" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ServiceItemBorder" Property="Background" Value="#EAF2FF"/>
                                <Setter TargetName="ServiceItemBorder" Property="BorderBrush" Value="#77A7E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                            <DataTemplate x:Key="ProcessCardTemplate">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <!-- Compact metrics reserve their own bounded columns. -->
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="98"/>
                                        <ColumnDefinition Width="84"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="34"
                                            Height="34"
                                            CornerRadius="7"
                                            Background="#F3F5F8"
                                            BorderBrush="#E1E5EA"
                                            BorderThickness="1"
                                            VerticalAlignment="Top"
                                            Margin="0,1,10,0">
                                        <Grid>
                                            <TextBlock Text="▣"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#A5ADB8"
                                                       FontSize="15"/>
                                            <Image Source="{Binding IconSource}" ToolTip="{Binding IconDescription}"
                                                   Width="26"
                                                   Height="26"
                                                   Stretch="Uniform"
                                                   SnapsToDevicePixels="True"/>
                                        </Grid>
                                    </Border>

                                    <!-- Nome e badge hanno righe proprie; troncamento soltanto con tooltip. -->
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding FriendlyName}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FriendlyName}"/>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Border Background="#EEF1F5" CornerRadius="5" Padding="6,2" Margin="0,0,6,3">
                                                <TextBlock Text="{Binding CategoryLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#5B6470"/>
                                            </Border>
                                            <Border Background="#EAF7EE" CornerRadius="5" Padding="6,2" Margin="0,0,0,3">
                                                <TextBlock Text="{Binding DetectionLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#27613B"/>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Activity}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#303846" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   ToolTip="{Binding Activity}"/>
                                        <TextBlock Text="{Binding ParentContext}" FontSize="11" Foreground="#7A8491"
                                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,4,0,0">
                                            <TextBlock Text="{Binding StartTimeLabel}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#46566B" Margin="0,0,12,2"/>
                                            <TextBlock Text="{Binding UptimeLabel}" FontSize="11" Foreground="#46566B"
                                                       Margin="0,0,0,2"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- A short visible label and full tooltip avoid overlap at compact widths. -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                        <TextBlock Text="CPU" FontSize="10" Foreground="#7A8491" TextAlignment="Right"
                                                   ToolTip="Quota della CPU complessiva attribuita al processo."/>
                                        <TextBlock Text="{Binding CpuDisplay}" FontSize="15" FontWeight="SemiBold"
                                                   TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding MemoryShortLabel}" FontSize="10" Foreground="#7A8491"
                                                   TextAlignment="Right" TextWrapping="Wrap" ToolTip="{Binding MemoryDescription}"/>
                                        <TextBlock Text="{Binding MemoryDisplayText}" ToolTip="{Binding MemoryDescription}"
                                                   FontSize="15" FontWeight="SemiBold" TextAlignment="Right"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding NetworkShortLabel}" FontSize="10" Foreground="#7A8491"
                                                   TextAlignment="Right" TextWrapping="Wrap" ToolTip="{Binding NetworkDescription}"/>
                                        <TextBlock Text="{Binding NetworkDisplayText}" ToolTip="{Binding NetworkDescription}"
                                                   FontSize="15" FontWeight="SemiBold" TextAlignment="Right"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>

        <DataTemplate x:Key="ProcessMemberTemplate">
            <Grid Margin="12,0,0,0" ToolTip="{Binding Process.ExecutablePath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="76"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="{Binding IconSource}" ToolTip="{Binding IconDescription}"
                       Width="20" Height="20" Stretch="Uniform" SnapsToDevicePixels="True"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding MemberLabel}" FontSize="11" TextWrapping="Wrap" Foreground="#667085"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding CpuDisplay}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock Text="{Binding MemoryShortLabel}" FontSize="9" TextAlignment="Right"/>
                    <TextBlock Text="{Binding MemoryDisplayText}" TextAlignment="Right" ToolTip="{Binding MemoryDescription}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NetworkShortLabel}" FontSize="9" TextAlignment="Right" Foreground="#667085"/>
                    <TextBlock Text="{Binding NetworkDisplayText}" TextAlignment="Right" ToolTip="{Binding NetworkDescription}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <Style x:Key="ApplicationGroupStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type GroupItem}">
                <Expander IsExpanded="{Binding Name.IsExpanded, Mode=TwoWay}" Margin="0,0,0,7" Background="#F4F7FC">
                    <Expander.Header><Grid ToolTip="{Binding Name.Description}" Margin="2,8,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="98"/>
                            <ColumnDefinition Width="84"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Name.IconSource}" ToolTip="{Binding Name.IconDescription}" Width="22" Height="22"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name.Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="5,0,6,0"/>
                        <StackPanel Grid.Column="2" Margin="0,0,6,0"><TextBlock Text="CPU" FontSize="9" TextAlignment="Right"/><TextBlock Text="{Binding Name.CpuDisplay}" TextWrapping="Wrap" FontWeight="SemiBold" TextAlignment="Right"/></StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,6,0"><TextBlock Text="{Binding Name.MemoryLabel}" TextWrapping="Wrap" FontSize="10" TextAlignment="Right"/><TextBlock Text="{Binding Name.MemoryDisplayText}" TextWrapping="Wrap" FontWeight="SemiBold" TextAlignment="Right"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="{Binding Name.NetworkLabel}" TextWrapping="Wrap" FontSize="9" TextAlignment="Right"/><TextBlock Text="{Binding Name.NetworkDisplayText}" ToolTip="{Binding Name.NetworkDescription}" TextWrapping="Wrap" FontWeight="SemiBold" TextAlignment="Right"/></StackPanel>
                    </Grid></Expander.Header>
                    <ItemsPresenter/>
                </Expander>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: title + search -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="AppTitleText" Text="ProcessLens" FontSize="24" FontWeight="SemiBold"/>
                <local:SelectableText x:Name="AppSubtitleText" Text="Dati Windows e analisi del processo" ToolTip="La X riduce la finestra; per riaprirla usa la barra applicazioni o Mostra ProcessLens nell’icona."
                           TextWrapping="Wrap"
                           Margin="1,3,0,0"
                           Foreground="#667085"
                           FontSize="12"/>
            </StackPanel>

            <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0" MaxWidth="420">
                <Button x:Name="LanguageButton" Content="Lingua: IT" Margin="2" Style="{StaticResource ActionButtonStyle}" Click="LanguageButton_Click" ToolTip="Cambia lingua tra Italiano e Inglese / Toggle language between Italian and English"/>
                <Button x:Name="MinimizeWindowButton" Content="Nascondi accanto all’orologio" Margin="2"
                        ToolTip="Nasconde la finestra e il log. Per riaprire: clic sull’icona ProcessLens accanto all’orologio, anche nel menu ^. Il trattino in alto riduce invece nella barra delle applicazioni."
                        Style="{StaticResource ActionButtonStyle}" Click="MinimizeWindow_Click"/>
                <Button x:Name="WindowLogButton" Content="Log finestra" Margin="2" Style="{StaticResource ActionButtonStyle}" Click="WindowLog_Click" ToolTip="Mostra e copia i passaggi di riduzione e ripristino della finestra."/>
                <Button x:Name="ExitApplicationButton" Content="Esci" Margin="2" Style="{StaticResource ActionButtonStyle}" Click="ExitApplication_Click" ToolTip="Chiude ProcessLens, senza ridurlo a icona."/>
                <Button x:Name="NewTaskButton" Content="Esegui nuova attività" Margin="2"
                        Style="{StaticResource ActionButtonStyle}" Click="NewTask_Click"/>
            </WrapPanel>
            <Border x:Name="SearchSurface" Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="12,9" MouseLeftButtonDown="SearchSurface_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SearchLabelText" Text="Cerca" FontWeight="SemiBold" Foreground="#667085" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Height="34"
                             BorderThickness="1" BorderBrush="#98A2B3" Padding="6,0"
                             Background="White" Foreground="#101828" CaretBrush="#175CD3"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             ToolTip="Cerca per nome visualizzato, eseguibile o PID esatto. Ctrl+F per scrivere."
                             TextChanged="SearchBox_TextChanged"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Barra adattiva: navigazione, filtri e indicatori su righe indipendenti. -->
        <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="10,7" Margin="0,0,0,8">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="NavProcessesButton" Content="Processi" Style="{StaticResource FilterButtonStyle}" Click="NavProcessesButton_Click"/>
                    <Button x:Name="NavSystemButton" Content="Sistema Windows" Style="{StaticResource FilterButtonStyle}" Click="NavSystemButton_Click"/>
                    <Button x:Name="NavServicesButton" Content="Servizi" Style="{StaticResource FilterButtonStyle}" Click="NavServicesButton_Click"/>
                    <Button x:Name="NavGuardianButton" Content="Guardian" Style="{StaticResource FilterButtonStyle}" Click="NavGuardianButton_Click"/>
                    <Button x:Name="NavNetworkButton" Content="Rete" Style="{StaticResource FilterButtonStyle}" Click="NavNetworkButton_Click"/>
                    <Button x:Name="NavMemoryButton" Content="Memoria RAM" Style="{StaticResource FilterButtonStyle}" Click="NavMemoryButton_Click"/>
                    <Border Width="1" Background="#D9DDE3" Margin="2,4,10,4"/>
                    <WrapPanel x:Name="ProcessFilters" Orientation="Horizontal">
                    <Button x:Name="FilterAllButton" Content="Tutti" Style="{StaticResource FilterButtonStyle}" Click="FilterAllButton_Click"/>
                    <Button x:Name="FilterAppsButton" Content="App" Style="{StaticResource FilterButtonStyle}" Click="FilterAppsButton_Click"/>
                    <Button x:Name="FilterDevButton" Content="Sviluppo" Style="{StaticResource FilterButtonStyle}" Click="FilterDevButton_Click"/>
                    <Button x:Name="FilterWindowsButton" Content="Windows" Style="{StaticResource FilterButtonStyle}" Click="FilterWindowsButton_Click"/>
                    <Button x:Name="FilterBackgroundButton" Content="Secondari" ToolTip="Categoria stimata dalle regole; non indica inattività." Style="{StaticResource FilterButtonStyle}" Click="FilterBackgroundButton_Click"/>
                    <Button x:Name="FilterWslButton" Content="WSL" Style="{StaticResource FilterButtonStyle}" Click="FilterWslButton_Click"/>
                    </WrapPanel>
                    <WrapPanel x:Name="ServiceFilters" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="ServiceFilterAllButton" Content="Tutti" Style="{StaticResource FilterButtonStyle}" Click="ServiceFilterAll_Click"/>
                        <Button x:Name="ServiceFilterRunningButton" Content="Attivi" Style="{StaticResource FilterButtonStyle}" Click="ServiceFilterRunning_Click"/>
                        <Button x:Name="ServiceFilterStoppedButton" Content="Arrestati" Style="{StaticResource FilterButtonStyle}" Click="ServiceFilterStopped_Click"/>
                    </WrapPanel>
                </WrapPanel>
                <!-- Gli indicatori non possono piu' sovrapporsi ai filtri. -->
                <WrapPanel Margin="0,11,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="ProcessDetectedCounter" Orientation="Horizontal" Margin="0,0,17,5">
                        <TextBlock x:Name="ProcessDetectedLabel" Text="Rilevati: " Foreground="#667085"
                                   ToolTip="Processi dell’ultimo rilevamento. Gli avvii brevi possono sfuggire."/>
                        <local:SelectableText x:Name="ProcessCountText" Text="-" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel x:Name="ProcessVisibleCounter" Orientation="Horizontal" Margin="0,0,17,5">
                        <TextBlock x:Name="ProcessVisibleLabel" Text="Mostrati: " Foreground="#667085" ToolTip="Righe dopo filtri e ricerca."/>
                        <local:SelectableText x:Name="VisibleCountText" Text="-" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,17,5">
                        <TextBlock x:Name="SystemCpuLabel" Text="CPU sistema: " Foreground="#667085"/>
                        <local:SelectableText x:Name="SystemCpuText" Text="In attesa…" FontWeight="Bold" Foreground="#124E87"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,17,5">
                        <TextBlock x:Name="SystemCpuAverageLabel" Text="Media fino a 30 s: " Foreground="#667085"/>
                        <local:SelectableText x:Name="SystemCpuAverageText" Text="-" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,17,5">
                        <TextBlock x:Name="LogicalCpuLabel" Text="CPU logici: " Foreground="#667085"/>
                        <local:SelectableText x:Name="LogicalCpuText" Text="-" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,17,5"
                                ToolTip="RAM fisica in uso / totale. Aggiornamento con il campione CPU; sospeso quando la finestra è ridotta.">
                        <TextBlock x:Name="SystemRamLabel" Text="RAM sistema: " Foreground="#667085"/>
                        <local:SelectableText x:Name="SystemRamText" Text="In attesa…" FontWeight="Bold" Foreground="#124E87"/>
                    </StackPanel>

                </WrapPanel>
                <Expander x:Name="GuiResourcesExpander" Header="Risorse di ProcessLens · CPU e RAM della GUI" IsExpanded="False" Margin="0,3,0,0">
                <DockPanel Margin="0,7,0,0" LastChildFill="True">
                    <Button x:Name="CopySelfResourcesButton" IsEnabled="False" DockPanel.Dock="Right" Content="Copia risorse GUI"
                            Style="{StaticResource ActionButtonStyle}" Margin="12,0,0,0"
                            Click="CopySelfResourcesButton_Click"/>
                    <local:SelectableText x:Name="SelfResourcesText" Text="Risorse GUI: in attesa del primo campione…"
                                          FontSize="11" Foreground="#667085" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                </Expander>
            </StackPanel>
        </Border>

        <ContentControl x:Name="GuardianDashboardHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="2" Visibility="Collapsed"/>
        <ContentControl x:Name="MemoryDashboardHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="2" Visibility="Collapsed"/>

        <ContentControl x:Name="NetworkDevicesHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="2" Visibility="Collapsed"/>

        <ContentControl x:Name="SystemProcessesHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="2" Visibility="Collapsed"/>

        <!-- Main area -->
        <Grid x:Name="ProcessWorkspace" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="420"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.25*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Process list -->
            <Border x:Name="ProcessListPanel" Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Intestazione a piu' righe: testo descrittivo e ordinamento non si sovrappongono. -->
                    <StackPanel Margin="2,0,2,12">
                        <TextBlock x:Name="ProcessListHeading" Text="Processi" FontSize="20" FontWeight="SemiBold"/>
                        <local:SelectableText x:Name="ListExplanationText"
                                   Text="Seleziona un processo per analizzarlo."
                                   Foreground="#667085" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,6"/>
                        <WrapPanel Orientation="Horizontal">
                            <local:SelectableText x:Name="CurrentFilterText" Text="Vista: tutti i processi" Foreground="#667085"
                                       VerticalAlignment="Center" Margin="0,0,14,4"/>
                            <TextBlock x:Name="SortLabelText" Text="Ordina" Foreground="#667085" VerticalAlignment="Center" Margin="0,0,7,4"/>
                            <CheckBox x:Name="GroupApplicationsCheckBox" Content="Raggruppa app" IsChecked="True" Margin="0,0,10,4" VerticalAlignment="Center"
                                      Checked="GroupApplications_Changed" Unchecked="GroupApplications_Changed" ToolTip="Stesso eseguibile e catena di avvio; espandi per scegliere un PID."/>
                            <ComboBox x:Name="SortModeComboBox" Width="135" SelectedIndex="0" Margin="0,0,0,4"
                                      SelectionChanged="SortModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Più recenti"/>
                                <ComboBoxItem Content="Più vecchi"/>
                                <ComboBoxItem Content="CPU"/>
                                <ComboBoxItem Content="Memoria"/>
                                <ComboBoxItem Content="Rete"/>
                                <ComboBoxItem Content="Nome"/>
                            </ComboBox>
                        </WrapPanel>
                    </StackPanel>

                    <ListView x:Name="ProcessList"
                              Grid.Row="1"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectionChanged="ProcessList_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              ItemContainerStyle="{StaticResource ProcessListItemStyle}">
