                                    <StackPanel Grid.Column="2">
                                        <local:SelectableText Text="MEMORIA PRIVATA IMPEGNATA" FontSize="10" Foreground="#667085" TextWrapping="Wrap" MinHeight="40"/>
                                        <local:SelectableText TextWrapping="Wrap" x:Name="DetailPrivateCommitText" FontSize="15" FontWeight="SemiBold" Text="N/D"/>
                                    </StackPanel>
                                </Grid>
                                <local:SelectableText x:Name="DetailMemoryExplanationText" FontSize="11" Foreground="#667085" TextWrapping="Wrap"/>
                                <local:SelectableText x:Name="DetailMemoryTrendText" FontSize="11" Foreground="#235E93" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                <local:SelectableText Text="Commit e RAM sono contatori diversi. Confronta stessa istanza, contatore e intervallo." FontSize="11" Foreground="#667085" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <Expander x:Name="DetailMemoryGuideExpander"
                                          Header="Che cosa significa RAM privata?"
                                          IsExpanded="False" Margin="0,12,0,0"
                                          ToolTip="Apri una guida alle tre misure di memoria del PID selezionato.">
                                    <Border Padding="10" Background="White" BorderBrush="#D9E2ED"
                                            BorderThickness="1" CornerRadius="7">
                                        <StackPanel>
                                            <local:SelectableText Text="1 · Working Set privato (Private Working Set)"
                                                       FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                            <local:SelectableText Text="Pagine private del processo presenti in RAM. Il valore non include tutti i suoi dati allocati o i sottoprocessi."
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                            <local:SelectableText Text="2 · Working Set totale (Working Set)"
                                                       FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                            <local:SelectableText Text="Pagine private e condivisibili presenti in RAM. Include il Working Set privato: non sommarli. Le pagine condivisibili possono comparire in più processi."
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                            <local:SelectableText Text="3 · Memoria privata impegnata (Private Bytes / commit)"
                                                       FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                            <local:SelectableText Text="Memoria privata con copertura garantita da Windows. Non misura RAM occupata o dati scritti nel file di paging."
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                            <local:SelectableText Text="Esempio basato sul processo selezionato"
                                                       FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                            <local:SelectableText x:Name="DetailMemoryGuideExampleText" Text="Seleziona un processo per vedere le misure."
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10" Foreground="#235E93"/>
                                            <local:SelectableText Text="Come interpretarle correttamente"
                                                       FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                            <local:SelectableText Text="Per cercare un memory leak, osserva lo stesso PID nel tempo insieme a commit e RAM del sistema. Sottoprocessi, GPU e kernel vanno valutati a parte. N/D non equivale a zero."
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                            <local:SelectableText Text="Origine dei contatori Windows"
                                                       FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                            <local:SelectableText Text="API GetProcessMemoryInfo, struttura PROCESS_MEMORY_COUNTERS_EX2: PrivateWorkingSetSize, WorkingSetSize e PrivateUsage. Sono misure riferite al PID; ProcessLens non stima queste quantità a partire dalle regioni di memoria virtuale."
                                                       FontSize="11" Foreground="#667085" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DetailCard}" Background="#F0F7FF" BorderBrush="#C8DDF4">
                            <StackPanel>
                                <TextBlock Text="ANALISI CPU · FINO A 30 SECONDI" Style="{StaticResource SectionLabel}"/>
                                <Grid Margin="0,8,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <local:SelectableText TextWrapping="Wrap" x:Name="DetailCpuAverageText" Text="Media: -" FontSize="14" FontWeight="SemiBold"/>
                                    <local:SelectableText TextWrapping="Wrap" x:Name="DetailCpuPeakText" Text="Picco: -" Grid.Column="1" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>
                                <local:SelectableText x:Name="DetailCpuCoreText" Text="-" FontSize="12" TextWrapping="Wrap"/>
                                <local:SelectableText x:Name="DetailCpuGroupText" Text="-" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <local:SelectableText x:Name="DetailCpuTotalTimeText" Text="-" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <local:SelectableText Text="CPU: quota della capacità totale del PC, non di un core. Campione ogni circa 2 s; elenco aggiornato a parte." FontSize="11" Foreground="#667085" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <local:SelectableText TextWrapping="Wrap" x:Name="CpuGraphScaleText" Text="-" FontSize="11" Foreground="#667085" Margin="0,8,0,3"/>
                                <Border BorderBrush="#CBDBED" BorderThickness="1" Background="White" CornerRadius="4" Padding="3">
                                    <Canvas x:Name="CpuGraphCanvas" Height="68" ClipToBounds="True" SizeChanged="CpuGraphCanvas_SizeChanged">
                                        <Polyline x:Name="CpuGraphLine" Stroke="#2376C3" StrokeThickness="2" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DetailCard}">
                            <StackPanel>
                                <TextBlock Text="ATTIVITÀ RILEVATA · CPU, RETE E FINESTRE" Style="{StaticResource SectionLabel}"/>
                                <local:SelectableText x:Name="DetailRuntimeStateText" Text="-" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <Button x:Name="RefreshProcessPortsButton" Content="Aggiorna porte del PID e del gruppo" Style="{StaticResource ActionButtonStyle}"
                                            Click="RefreshProcessPorts_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                        <local:SelectableText x:Name="DetailNetworkStateText" Text="-" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <local:SelectableText x:Name="DetailWindowStateText" Text="-" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <local:SelectableText Text="CPU, finestre e rete sono osservazioni Windows. L'analisi approfondita parte solo sul processo selezionato per mantenere ProcessLens leggero." Foreground="#667085" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- v0.19.10: disclosure progressiva. Evita un unico muro di testo diagnostico. -->
                        <Expander x:Name="DetailTechnicalSectionsExpander" Header="Dettagli tecnici e fonti"
                                  IsExpanded="False" FontWeight="SemiBold" Margin="0,8,0,0"
                                  Expanded="DetailTechnicalSections_Expanded" Collapsed="DetailTechnicalSections_Collapsed">
                            <StackPanel Margin="0,12,0,0">
                                <local:SelectableText Text="Apri una sezione. Dati Windows e classificazione locale."
                                           FontWeight="Normal" Foreground="#667085" TextWrapping="Wrap"
                                           FontSize="12" Margin="0,0,0,12"/>

                                <Expander Header="Identità e ambiente di esecuzione" IsExpanded="True"
                                          Margin="0,0,0,8" Padding="0,3">
                                    <Border Style="{StaticResource DetailCard}" Padding="14">
                                        <StackPanel x:Name="DetailIdentityFactsPanel"/>
                                    </Border>
                                </Expander>

                                <Expander Header="CPU e memoria: dati misurati" IsExpanded="False"
                                          Margin="0,0,0,8" Padding="0,3">
                                    <Border Style="{StaticResource DetailCard}" Padding="14">
                                        <StackPanel x:Name="DetailResourceFactsPanel"/>
                                    </Border>
                                </Expander>

                                <Expander Header="Rete, servizi e relazioni" IsExpanded="False"
                                          Margin="0,0,0,8" Padding="0,3">
                                    <Border Style="{StaticResource DetailCard}" Padding="14">
                                        <StackPanel x:Name="DetailNetworkFactsPanel"/>
                                    </Border>
                                </Expander>

                                <Expander Header="Percorso e parametri di avvio" IsExpanded="False"
                                          Margin="0,0,0,8" Padding="0,3">
                                    <Border Style="{StaticResource DetailCard}">
                                        <StackPanel>
                                            <TextBlock Text="PERCORSO DELL'ESEGUIBILE" Style="{StaticResource SectionLabel}"/>
                                            <local:SelectableText x:Name="DetailExecutableText" IsReadOnly="True"
                                                     FontFamily="Consolas" FontSize="12" BorderThickness="0"
                                                     TextWrapping="Wrap" Background="#F0F3F7" Padding="12"
                                                     Margin="0,0,0,15"/>
                                            <TextBlock Text="PARAMETRI DI AVVIO" Style="{StaticResource SectionLabel}"/>
                                            <local:SelectableText Text="Un parametro -- per riga. Originale disponibile sotto."
                                                       Foreground="#667085" FontSize="11" FontWeight="Normal"
                                                       TextWrapping="Wrap" Margin="0,0,0,7"/>
                                            <local:SelectableText x:Name="DetailFormattedCommandLineText" IsReadOnly="True"
                                                     FontFamily="Consolas" FontSize="12" FontWeight="Normal"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     MaxHeight="175" MinHeight="55" BorderThickness="0"
                                                     Background="#F0F3F7" Padding="12" Margin="0,0,0,10"/>
                                            <Expander Header="Mostra la riga di comando originale" IsExpanded="False">
                                                <local:SelectableText x:Name="DetailCommandLineText" IsReadOnly="True"
                                                         FontFamily="Consolas" FontSize="11" FontWeight="Normal"
                                                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                                                         VerticalScrollBarVisibility="Auto" MaxHeight="130"
                                                         Background="#F0F3F7" BorderThickness="0"
                                                         Padding="10" Margin="0,8,0,0"/>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <Expander Header="Dati e fonti dell'identificazione" IsExpanded="False"
                                          Margin="0,0,0,8" Padding="0,3">
                                    <Border Style="{StaticResource DetailCard}">
                                        <StackPanel>
                                            <Border Background="#EEF5FF" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <local:SelectableText Text="QUADRO GENERALE" FontWeight="SemiBold" FontSize="11.5"
                                                                          Foreground="#315B8A" Margin="0,0,0,6"/>
                                                    <local:SelectableText x:Name="DetailEvidenceOverviewText" Text="Dati per argomento."
                                                                          FontWeight="Normal" Foreground="#334155" TextWrapping="Wrap" FontSize="12.5"/>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel x:Name="DetailEvidenceGroupsPanel"/>
                                            <Expander Header="Dati originali completi" IsExpanded="False" Margin="0,10,0,0">
                                                <local:SelectableText x:Name="DetailEvidenceText" FontFamily="Consolas" FontSize="11"
                                                           FontWeight="Normal" Foreground="#516176"
                                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <Expander Header="Diagnostica completa in formato originale" IsExpanded="False"
                                          Margin="0,0,0,8" Padding="0,3">
                                    <Border Style="{StaticResource DetailCard}">
                                        <StackPanel>
                                            <local:SelectableText Text="Snapshot dell’ultimo aggiornamento dei dettagli. I valori CPU aggiornati continuamente sono nel riquadro Analisi CPU."
                                                                  TextWrapping="Wrap" FontSize="11" Foreground="#667085" Margin="0,0,0,8"/>
                                        <local:SelectableText x:Name="DetailTechnicalContextText" FontFamily="Consolas" FontSize="11"
                                                   FontWeight="Normal" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Dedicated read-only SCM service explorer. Not a Task Manager overlay. -->
        <Grid x:Name="ServiceWorkspace" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="420"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.25*" MinWidth="400"/>
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#D8E1EC"
                          ShowsPreview="True" Focusable="True" ToolTip="Ridimensiona elenco e dettagli dei servizi"/>
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Servizi Windows" FontSize="20" FontWeight="SemiBold"/>
                            <local:SelectableText x:Name="ServicesCountText" Text="Caricamento..." Foreground="#667085" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Ordina" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="#667085"/>
                            <ComboBox x:Name="ServiceSortComboBox" Width="190" SelectedIndex="0" SelectionChanged="ServiceSort_SelectionChanged">
                                <ComboBoxItem Content="Attivi prima, poi nome"/>
                                <ComboBoxItem Content="Nome A-Z"/>
                                <ComboBoxItem Content="Tipo di avvio"/>
                                <ComboBoxItem Content="PID"/>
                            </ComboBox>
                            <Button Style="{StaticResource ActionButtonStyle}" Content="Aggiorna" Margin="9,0,0,0" Padding="10,6" Click="RefreshServices_Click"/>
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="ServiceList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                              SelectionChanged="ServiceList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ItemContainerStyle="{StaticResource ServiceListItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="105"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#667085" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="{Binding StartupLabel}" TextTrimming="CharacterEllipsis" Foreground="#667085" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="PID host" FontSize="10" Foreground="#667085" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding ProcessIdLabel}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Dettagli del servizio" FontSize="20" FontWeight="SemiBold"/>
                        <local:SelectableText x:Name="ServiceScopeText" Text="Tutti i servizi SCM" TextWrapping="Wrap" Margin="0,6,0,4"/>
                        <Button x:Name="ShowAllServicesButton" Content="Mostra tutti i servizi" Style="{StaticResource ActionButtonStyle}"
                                Click="ShowAllServices_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                        <local:SelectableText Text="SCM: stato e configurazione del servizio."
                                   Foreground="#667085" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,12"/>
                        <Border Style="{StaticResource DetailCard}" Background="#EEF4FF" BorderBrush="#C9DBF6">
                            <StackPanel>
                                <local:SelectableText x:Name="ServiceDetailName" Text="Seleziona un servizio" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <local:SelectableText x:Name="ServiceDetailIdentity" Text="" Foreground="#667085" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                <local:SelectableText x:Name="ServiceDetailStatus" Text="" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailCard}">
                            <StackPanel>
                                <TextBlock Text="DESCRIZIONE DEL SERVIZIO" Style="{StaticResource SectionLabel}"/>
                                <local:SelectableText x:Name="ServiceDetailDescription" Text="Descrizione non disponibile." TextWrapping="Wrap" FontSize="13"/>
                                <local:SelectableText Text="Fonte: descrizione dichiarata dal servizio, se disponibile." Foreground="#667085" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailCard}">
                            <StackPanel>
                                <TextBlock Text="MODALITÀ DI AVVIO E STATO" Style="{StaticResource SectionLabel}"/>
                                <local:SelectableText x:Name="ServiceDetailWhy" Text="" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailCard}" Background="#F6FAFF" BorderBrush="#CDDEF5">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="CRONOLOGIA AVVIO / ARRESTO" Style="{StaticResource SectionLabel}"
                                               DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource ActionButtonStyle}" x:Name="ServiceHistoryRefreshButton" Content="Aggiorna eventi"
                                            DockPanel.Dock="Right" Margin="10,0,0,0" Padding="8,5"
                                            Click="RefreshServiceHistory_Click" IsEnabled="False"/>
                                </DockPanel>
                                <local:SelectableText x:Name="ServiceHistoryStatusText" Text="Seleziona un servizio per consultare gli eventi Windows."
                                           Foreground="#667085" TextWrapping="Wrap" Margin="0,7,0,6" FontSize="11"/>
                                <local:SelectableText x:Name="ServiceHistoryExplanationText" Text=""
                                           TextWrapping="Wrap" Margin="0,4,0,10" FontSize="12"/>
                                <ItemsControl x:Name="ServiceHistoryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#DEE4ED" BorderThickness="0,1,0,0" Padding="0,9,0,8">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="True">
                                                        <local:SelectableText Text="{Binding WhenLabel, Mode=OneWay}" Foreground="#405676" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0"/>
                                                        <local:SelectableText Text="{Binding EventIdLabel, Mode=OneWay}" Foreground="#64748B" FontSize="11"/>
                                                    </DockPanel>
                                                    <local:SelectableText Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
                                                    <local:SelectableText Text="{Binding Detail, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <local:SelectableText Text="Eventi SCM. Richiedente dell’avvio non identificato; i vecchi eventi possono mancare."
                                           Foreground="#667085" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailCard}">
                            <StackPanel>
                                <TextBlock Text="PROCESSO CHE LO OSPITA" Style="{StaticResource SectionLabel}"/>
                                <local:SelectableText x:Name="ServiceDetailHost" Text="" TextWrapping="Wrap"/>
                                <Button Style="{StaticResource ActionButtonStyle}" x:Name="ServiceShowProcessButton" Content="Mostra processo ospitante" Padding="8,6"
                                        HorizontalAlignment="Left" Margin="0,10,0,0" Click="ServiceShowProcess_Click" IsEnabled="False"/>
                                <Button Style="{StaticResource ActionButtonStyle}" x:Name="ServiceStopButton" Content="Arresta servizio…" Padding="10,7"
                                        HorizontalAlignment="Left" Margin="0,10,0,0" Click="ServiceStopButton_Click" IsEnabled="False"/>
                                <local:SelectableText Text="Arresto tramite SCM; nessuna terminazione forzata del PID."
                                           Foreground="#667085" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailCard}">
                            <StackPanel>
                                <TextBlock Text="AVVIO E DIPENDENZE" Style="{StaticResource SectionLabel}"/>
                                <local:SelectableText x:Name="ServiceDetailDependencies" Text="" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailCard}">
                            <StackPanel>
                                <TextBlock Text="SE VIENE ARRESTATO" Style="{StaticResource SectionLabel}"/>
                                <local:SelectableText x:Name="ServiceDetailImpact" Text="" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Expander Header="Identità tecnica e percorso" Margin="0,2,0,12" FontWeight="SemiBold">
                            <local:SelectableText x:Name="ServiceDetailTechnical" IsReadOnly="True" BorderThickness="0"
                                     Background="#F8F9FB" TextWrapping="Wrap" Margin="0,8,0,0" Padding="10"/>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <!-- Passive, in-window notice: no focus change or confirmation dialog. -->
        <Border x:Name="ProcessNoticeCard" Grid.RowSpan="3" Panel.ZIndex="20" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="420" Margin="12"
                Padding="14,11" Background="#EDF7F1" BorderBrush="#8DBDA2" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <local:SelectableText x:Name="ProcessNoticeTitleText" Text="Processo chiuso"
                                      FontSize="13" FontWeight="SemiBold" Foreground="#195734"/>
                <local:SelectableText x:Name="ProcessNoticeText" FontSize="12.5" TextWrapping="Wrap"
                                      Foreground="#234B35" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
