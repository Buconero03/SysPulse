<l10n:LocalizedWindow x:Class="ProcessLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l10n="clr-namespace:ProcessLens.App"
        xmlns:local="clr-namespace:ProcessLens.App"
        Title="SysPulse"
        Width="1180"
        Height="800"
        MinWidth="950"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        Foreground="#202124">

    <Window.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E5E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SelectableSectionLabel" TargetType="local:SelectableText">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="DetailCard" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Text content wraps inside the native WPF button without a fixed height. -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <l10n:LocalizedTextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D9DDE3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProcessListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ProcessItem_RightMouseDown"/>
            <EventSetter Event="Loaded" Handler="ProcessItem_Loaded"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#C9D2DE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EAF2FF"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#77A7E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ServiceListItemStyle" TargetType="ListViewItem">
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ServiceItem_RightMouseDown"/>
            <EventSetter Event="MouseDoubleClick" Handler="ServiceItem_MouseDoubleClick"/>
            <EventSetter Event="KeyDown" Handler="ServiceItem_KeyDown"/>
            <EventSetter Event="Loaded" Handler="ServiceItem_Loaded"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ServiceItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ServiceItemBorder" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ServiceItemBorder" Property="Background" Value="#EAF2FF"/>
                                <Setter TargetName="ServiceItemBorder" Property="BorderBrush" Value="#77A7E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                            <DataTemplate x:Key="ProcessCardTemplate">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <!-- Compact metrics reserve their own bounded columns. -->
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="98"/>
                                        <ColumnDefinition Width="84"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="34"
                                            Height="34"
                                            CornerRadius="7"
                                            Background="#F3F5F8"
                                            BorderBrush="#E1E5EA"
                                            BorderThickness="1"
                                            VerticalAlignment="Top"
                                            Margin="0,1,10,0">
                                        <Grid>
                                            <l10n:LocalizedTextBlock Text="{l10n:Tr B4203FA7CF77756E}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#A5ADB8"
                                                       FontSize="15"/>
                                            <Image Source="{Binding IconSource}" ToolTip="{Binding IconDescription}"
                                                   Width="26"
                                                   Height="26"
                                                   Stretch="Uniform"
                                                   SnapsToDevicePixels="True"/>
                                        </Grid>
                                    </Border>

                                    <!-- Nome e badge hanno righe proprie; troncamento soltanto con tooltip. -->
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <l10n:LocalizedTextBlock Text="{Binding FriendlyName}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FriendlyName}"/>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Border Background="#EEF1F5" CornerRadius="5" Padding="6,2" Margin="0,0,6,3">
                                                <l10n:LocalizedTextBlock Text="{Binding CategoryLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#5B6470"/>
                                            </Border>
                                            <Border Background="#EAF7EE" CornerRadius="5" Padding="6,2" Margin="0,0,0,3">
                                                <l10n:LocalizedTextBlock Text="{Binding DetectionLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#27613B"/>
                                            </Border>
                                        </WrapPanel>
                                        <l10n:LocalizedTextBlock Text="{Binding Activity}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#303846" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   ToolTip="{Binding Activity}"/>
                                        <l10n:LocalizedTextBlock Text="{Binding ParentContext}" FontSize="11" Foreground="#7A8491"
                                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,4,0,0">
                                            <l10n:LocalizedTextBlock Text="{Binding StartTimeLabel}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#46566B" Margin="0,0,12,2"/>
                                            <l10n:LocalizedTextBlock Text="{Binding UptimeLabel}" FontSize="11" Foreground="#46566B"
                                                       Margin="0,0,0,2"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- A short visible label and full tooltip avoid overlap at compact widths. -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                        <l10n:LocalizedTextBlock Text="{l10n:Tr DB9A4C7D4C195EBF}" FontSize="10" Foreground="#7A8491" TextAlignment="Right"
                                                   ToolTip="{l10n:Tr F360B7287B83C20A}"/>
                                        <l10n:LocalizedTextBlock Text="{Binding CpuDisplay}" FontSize="15" FontWeight="SemiBold"
                                                   TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                        <l10n:LocalizedTextBlock Text="{Binding MemoryShortLabel}" FontSize="10" Foreground="#7A8491"
                                                   TextAlignment="Right" TextWrapping="Wrap" ToolTip="{Binding MemoryDescription}"/>
                                        <l10n:LocalizedTextBlock Text="{Binding MemoryDisplayText}" ToolTip="{Binding MemoryDescription}"
                                                   FontSize="15" FontWeight="SemiBold" TextAlignment="Right"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <l10n:LocalizedTextBlock Text="{Binding NetworkShortLabel}" FontSize="10" Foreground="#7A8491"
                                                   TextAlignment="Right" TextWrapping="Wrap" ToolTip="{Binding NetworkDescription}"/>
                                        <l10n:LocalizedTextBlock Text="{Binding NetworkDisplayText}" ToolTip="{Binding NetworkDescription}"
                                                   FontSize="15" FontWeight="SemiBold" TextAlignment="Right"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>

        <DataTemplate x:Key="ProcessMemberTemplate">
            <Grid Margin="12,0,0,0" ToolTip="{Binding Process.ExecutablePath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="76"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="{Binding IconSource}" ToolTip="{Binding IconDescription}"
                       Width="20" Height="20" Stretch="Uniform" SnapsToDevicePixels="True"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <l10n:LocalizedTextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <l10n:LocalizedTextBlock Text="{Binding MemberLabel}" FontSize="11" TextWrapping="Wrap" Foreground="#667085"/>
                </StackPanel>
                <l10n:LocalizedTextBlock Grid.Column="2" Text="{Binding CpuDisplay}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,6,0">
                    <l10n:LocalizedTextBlock Text="{Binding MemoryShortLabel}" FontSize="9" TextAlignment="Right"/>
                    <l10n:LocalizedTextBlock Text="{Binding MemoryDisplayText}" TextAlignment="Right" ToolTip="{Binding MemoryDescription}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <l10n:LocalizedTextBlock Text="{Binding NetworkShortLabel}" FontSize="9" TextAlignment="Right" Foreground="#667085"/>
                    <l10n:LocalizedTextBlock Text="{Binding NetworkDisplayText}" TextAlignment="Right" ToolTip="{Binding NetworkDescription}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <Style x:Key="ApplicationGroupStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type GroupItem}">
                <l10n:LocalizedExpander IsExpanded="{Binding Name.IsExpanded, Mode=TwoWay}" Margin="0,0,0,7" Background="#F4F7FC">
                    <Expander.Header><Grid ToolTip="{Binding Name.Description}" Margin="2,8,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="98"/>
                            <ColumnDefinition Width="84"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Name.IconSource}" ToolTip="{Binding Name.IconDescription}" Width="22" Height="22"/>
                        <l10n:LocalizedTextBlock Grid.Column="1" Text="{Binding Name.Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="5,0,6,0"/>
                        <StackPanel Grid.Column="2" Margin="0,0,6,0"><l10n:LocalizedTextBlock Text="{l10n:Tr DB9A4C7D4C195EBF}" FontSize="9" TextAlignment="Right"/><l10n:LocalizedTextBlock Text="{Binding Name.CpuDisplay}" TextWrapping="Wrap" FontWeight="SemiBold" TextAlignment="Right"/></StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,6,0"><l10n:LocalizedTextBlock Text="{Binding Name.MemoryLabel}" TextWrapping="Wrap" FontSize="10" TextAlignment="Right"/><l10n:LocalizedTextBlock Text="{Binding Name.MemoryDisplayText}" TextWrapping="Wrap" FontWeight="SemiBold" TextAlignment="Right"/></StackPanel>
                        <StackPanel Grid.Column="4"><l10n:LocalizedTextBlock Text="{Binding Name.NetworkLabel}" TextWrapping="Wrap" FontSize="9" TextAlignment="Right"/><l10n:LocalizedTextBlock Text="{Binding Name.NetworkDisplayText}" ToolTip="{Binding Name.NetworkDescription}" TextWrapping="Wrap" FontWeight="SemiBold" TextAlignment="Right"/></StackPanel>
                    </Grid></Expander.Header>
                    <ItemsPresenter/>
                </l10n:LocalizedExpander>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: title + search -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <l10n:LocalizedTextBlock x:Name="AppTitleText" Text="{l10n:Tr B615C19E2770D434}" FontSize="24" FontWeight="SemiBold"/>
                <local:SelectableText x:Name="AppSubtitleText" Text="{l10n:Tr 189B6A37EC6BEFCA}" ToolTip="{l10n:Tr FAA28AF86595E99B}"
                           TextWrapping="Wrap"
                           Margin="1,3,0,0"
                           Foreground="#667085"
                           FontSize="12"/>
            </StackPanel>

            <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0" MaxWidth="420">
                <l10n:LocalizedButton x:Name="LanguageButton" Content="{l10n:Tr 6C537D0287F5D2DA}" Margin="2" Style="{StaticResource ActionButtonStyle}" Click="LanguageButton_Click" ToolTip="{l10n:Tr 949EF2A808F911EF}"/>
                <l10n:LocalizedButton x:Name="MinimizeWindowButton" Content="{l10n:Tr 841F3A5AC308E00D}" Margin="2"
                        ToolTip="{l10n:Tr 1E85B038E8D17DBC}"
                        Style="{StaticResource ActionButtonStyle}" Click="MinimizeWindow_Click"/>
                <l10n:LocalizedButton x:Name="WindowLogButton" Content="{l10n:Tr 0D899C869CD783DB}" Margin="2" Style="{StaticResource ActionButtonStyle}" Click="WindowLog_Click" ToolTip="{l10n:Tr AFC96EDE88883AA3}"/>
                <l10n:LocalizedButton x:Name="ExitApplicationButton" Content="{l10n:Tr 58025F3619BFAF77}" Margin="2" Style="{StaticResource ActionButtonStyle}" Click="ExitApplication_Click" ToolTip="{l10n:Tr 47F171EB9236318D}"/>
                <l10n:LocalizedButton x:Name="NewTaskButton" Content="{l10n:Tr 4140E6D90AA23E15}" Margin="2"
                        Style="{StaticResource ActionButtonStyle}" Click="NewTask_Click"/>
            </WrapPanel>
            <Border x:Name="SearchSurface" Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="12,9" MouseLeftButtonDown="SearchSurface_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <l10n:LocalizedTextBlock x:Name="SearchLabelText" Text="{l10n:Tr 15910E265A5D3CFC}" FontWeight="SemiBold" Foreground="#667085" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <l10n:LocalizedTextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Height="34"
                             BorderThickness="1" BorderBrush="#98A2B3" Padding="6,0"
                             Background="White" Foreground="#101828" CaretBrush="#175CD3"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             ToolTip="{l10n:Tr 62C0D2FC3ED73468}"
                             TextChanged="SearchBox_TextChanged"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Barra adattiva: navigazione, filtri e indicatori su righe indipendenti. -->
        <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="10,7" Margin="0,0,0,8">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <l10n:LocalizedButton x:Name="NavProcessesButton" Content="{l10n:Tr ABF6FAC21769C1F1}" Style="{StaticResource FilterButtonStyle}" Click="NavProcessesButton_Click"/>
                    <l10n:LocalizedButton x:Name="NavSystemButton" Content="{l10n:Tr BDF0E9FDABE513F6}" Style="{StaticResource FilterButtonStyle}" Click="NavSystemButton_Click"/>
                    <l10n:LocalizedButton x:Name="NavServicesButton" Content="{l10n:Tr E08BC21EB694A15B}" Style="{StaticResource FilterButtonStyle}" Click="NavServicesButton_Click"/>
                    <l10n:LocalizedButton x:Name="NavGuardianButton" Content="{l10n:Tr 1D228F258F494C8A}" Style="{StaticResource FilterButtonStyle}" Click="NavGuardianButton_Click"/>
                    <l10n:LocalizedButton x:Name="NavNetworkButton" Content="{l10n:Tr A0DD274E04A0BDBF}" Style="{StaticResource FilterButtonStyle}" Click="NavNetworkButton_Click"/>
                    <l10n:LocalizedButton x:Name="NavMemoryButton" Content="{l10n:Tr 451E3849B8AA5DBC}" Style="{StaticResource FilterButtonStyle}" Click="NavMemoryButton_Click"/>
                    <Border Width="1" Background="#D9DDE3" Margin="2,4,10,4"/>
                    <WrapPanel x:Name="ProcessFilters" Orientation="Horizontal">
                    <l10n:LocalizedButton x:Name="FilterAllButton" Content="{l10n:Tr 7F65EF4AF637AE9B}" Style="{StaticResource FilterButtonStyle}" Click="FilterAllButton_Click"/>
                    <l10n:LocalizedButton x:Name="FilterAppsButton" Content="{l10n:Tr 0D04BFEB7D64B71C}" Style="{StaticResource FilterButtonStyle}" Click="FilterAppsButton_Click"/>
                    <l10n:LocalizedButton x:Name="FilterDevButton" Content="{l10n:Tr 2CF6D08EF68E2F9A}" Style="{StaticResource FilterButtonStyle}" Click="FilterDevButton_Click"/>
                    <l10n:LocalizedButton x:Name="FilterWindowsButton" Content="{l10n:Tr D598026A9CBC6050}" Style="{StaticResource FilterButtonStyle}" Click="FilterWindowsButton_Click"/>
                    <l10n:LocalizedButton x:Name="FilterBackgroundButton" Content="{l10n:Tr 3A2801175F6A8DCE}" ToolTip="{l10n:Tr 0394882240FEF071}" Style="{StaticResource FilterButtonStyle}" Click="FilterBackgroundButton_Click"/>
                    <l10n:LocalizedButton x:Name="FilterWslButton" Content="{l10n:Tr F9F9595E5ABB085E}" Style="{StaticResource FilterButtonStyle}" Click="FilterWslButton_Click"/>
                    </WrapPanel>
                    <WrapPanel x:Name="ServiceFilters" Orientation="Horizontal" Visibility="Collapsed">
                        <l10n:LocalizedButton x:Name="ServiceFilterAllButton" Content="{l10n:Tr 7F65EF4AF637AE9B}" Style="{StaticResource FilterButtonStyle}" Click="ServiceFilterAll_Click"/>
                        <l10n:LocalizedButton x:Name="ServiceFilterRunningButton" Content="{l10n:Tr E0D570D26F65E3F6}" Style="{StaticResource FilterButtonStyle}" Click="ServiceFilterRunning_Click"/>
                        <l10n:LocalizedButton x:Name="ServiceFilterStoppedButton" Content="{l10n:Tr 0F0A30F08D930E69}" Style="{StaticResource FilterButtonStyle}" Click="ServiceFilterStopped_Click"/>
                    </WrapPanel>
                </WrapPanel>
                <!-- Gli indicatori non possono piu' sovrapporsi ai filtri. -->
                <WrapPanel Margin="0,11,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="ProcessDetectedCounter" Orientation="Horizontal" Margin="0,0,17,5">
                        <l10n:LocalizedTextBlock x:Name="ProcessDetectedLabel" Text="{l10n:Tr 9D0D40FD32D9BA89}" Foreground="#667085"
                                   ToolTip="{l10n:Tr 3D1EC10352B9B3DC}"/>
                        <local:SelectableText x:Name="ProcessCountText" Text="{l10n:Tr 3973E022E93220F9}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel x:Name="ProcessVisibleCounter" Orientation="Horizontal" Margin="0,0,17,5">
                        <l10n:LocalizedTextBlock x:Name="ProcessVisibleLabel" Text="{l10n:Tr 7CE19892FA963289}" Foreground="#667085" ToolTip="{l10n:Tr 77C3D5D8FC6FFC23}"/>
                        <local:SelectableText x:Name="VisibleCountText" Text="{l10n:Tr 3973E022E93220F9}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,17,5">
                        <l10n:LocalizedTextBlock x:Name="SystemCpuLabel" Text="{l10n:Tr 6942593F8D8B844C}" Foreground="#667085"/>
                        <local:SelectableText x:Name="SystemCpuText" Text="{l10n:Tr EE169FC3154D121B}" FontWeight="Bold" Foreground="#124E87"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,17,5">
                        <l10n:LocalizedTextBlock x:Name="SystemCpuAverageLabel" Text="{l10n:Tr 610FDC735CE18FFD}" Foreground="#667085"/>
                        <local:SelectableText x:Name="SystemCpuAverageText" Text="{l10n:Tr 3973E022E93220F9}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,17,5">
                        <l10n:LocalizedTextBlock x:Name="LogicalCpuLabel" Text="{l10n:Tr 2E0D782FE9549FDE}" Foreground="#667085"/>
                        <local:SelectableText x:Name="LogicalCpuText" Text="{l10n:Tr 3973E022E93220F9}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,17,5"
                                ToolTip="{l10n:Tr 0EE30E75549B4BA7}">
                        <l10n:LocalizedTextBlock x:Name="SystemRamLabel" Text="{l10n:Tr F25B22FE2E4BE644}" Foreground="#667085"/>
                        <local:SelectableText x:Name="SystemRamText" Text="{l10n:Tr EE169FC3154D121B}" FontWeight="Bold" Foreground="#124E87"/>
                    </StackPanel>

                </WrapPanel>
                <l10n:LocalizedExpander x:Name="GuiResourcesExpander" Header="{l10n:Tr 58D60D6FA08E6C39}" IsExpanded="False" Margin="0,3,0,0">
                <DockPanel Margin="0,7,0,0" LastChildFill="True">
                    <l10n:LocalizedButton x:Name="CopySelfResourcesButton" IsEnabled="False" DockPanel.Dock="Right" Content="{l10n:Tr 26FC06D3E4D933FC}"
                            Style="{StaticResource ActionButtonStyle}" Margin="12,0,0,0"
                            Click="CopySelfResourcesButton_Click"/>
                    <local:SelectableText x:Name="SelfResourcesText" Text="{l10n:Tr E2A807BCBCA49F1A}"
                                          FontSize="11" Foreground="#667085" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                </l10n:LocalizedExpander>
            </StackPanel>
        </Border>

        <ContentControl x:Name="GuardianDashboardHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="2" Visibility="Collapsed"/>
        <ContentControl x:Name="MemoryDashboardHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="2" Visibility="Collapsed"/>

        <ContentControl x:Name="NetworkDevicesHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="2" Visibility="Collapsed"/>

        <ContentControl x:Name="SystemProcessesHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="2" Visibility="Collapsed"/>

        <!-- Main area -->
        <Grid x:Name="ProcessWorkspace" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="420"/>
                <ColumnDefinition Width="10"/>
