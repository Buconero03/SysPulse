@@ -0,0 +1,119 @@
+param([switch] $NoPrompt)
+$ErrorActionPreference = 'Stop'
+if ($env:OS -ne 'Windows_NT') { throw 'Diagnostica disponibile su Windows.' }
+$lines = New-Object 'System.Collections.Generic.List[string]'
+function Add-Result([string] $Text) { $lines.Add($Text); Write-Host $Text }
+$admin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
+Add-Result ('ProcessLens - prerequisiti rete - ' + [DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))
+Add-Result ('Windows: ' + [Environment]::OSVersion.Version.ToString() + ' | processo 64 bit: ' + [Environment]::Is64BitProcess)
+Add-Result ('Amministratore: ' + $admin)
+Add-Result 'Controllo locale: nessuna cattura, scansione Wi-Fi, sonda, modifica a servizi, audit o firewall.'
+foreach ($name in @('WlanSvc', 'EventLog')) {
+    try { $service = Get-Service -Name $name -ErrorAction Stop; Add-Result ('Servizio ' + $name + ': ' + $service.Status) }
+    catch { Add-Result ('Servizio ' + $name + ': N/D - ' + $_.Exception.Message) }
+}
+try {
+    $adapters = @([Net.NetworkInformation.NetworkInterface]::GetAllNetworkInterfaces())
+    $wifi = @($adapters | Where-Object { $_.NetworkInterfaceType -eq [Net.NetworkInformation.NetworkInterfaceType]::Wireless80211 })
+    Add-Result ('Interfacce classificate Wi-Fi da Windows: ' + $wifi.Count)
+    $ipv4 = 0
+    foreach ($adapter in $adapters) {
+        if ($adapter.OperationalStatus -eq [Net.NetworkInformation.OperationalStatus]::Up -and
+            $adapter.NetworkInterfaceType -ne [Net.NetworkInformation.NetworkInterfaceType]::Loopback) {
+            $ipv4 += @($adapter.GetIPProperties().UnicastAddresses | Where-Object { $_.Address.AddressFamily -eq [Net.Sockets.AddressFamily]::InterNetwork }).Count
+        }
+    }
+    Add-Result ('Indirizzi IPv4 locali su interfacce attive: ' + $ipv4 + ' (indirizzi non salvati nel rapporto)')
+} catch { Add-Result ('Inventario interfacce: N/D - ' + $_.Exception.Message) }
+try {
+    if (-not ('ProcessLensSetup.NativeCheck' -as [type])) {
+        Add-Type -TypeDefinition @'
+using System;
+using System.ComponentModel;
+using System.Runtime.InteropServices;
+namespace ProcessLensSetup {
+ public static class NativeCheck {
+  [DllImport("kernel32.dll", CharSet=CharSet.Unicode, SetLastError=true)]
+  static extern IntPtr LoadLibraryEx(string name, IntPtr file, uint flags);
+  [DllImport("kernel32.dll", CharSet=CharSet.Ansi, ExactSpelling=true)]
+  static extern IntPtr GetProcAddress(IntPtr module, string name);
+  [DllImport("kernel32.dll")] static extern bool FreeLibrary(IntPtr module);
+  [DllImport("wlanapi.dll")] static extern uint WlanOpenHandle(uint version, IntPtr reserved, out uint negotiated, out IntPtr client);
+  [DllImport("wlanapi.dll")] static extern uint WlanEnumInterfaces(IntPtr client, IntPtr reserved, out IntPtr list);
+  [DllImport("wlanapi.dll")] static extern void WlanFreeMemory(IntPtr memory);
+  [DllImport("wlanapi.dll")] static extern uint WlanCloseHandle(IntPtr client, IntPtr reserved);
+  public static string Exports(string path) {
+   IntPtr module=LoadLibraryEx(path,IntPtr.Zero,0x800);
+   if(module==IntPtr.Zero) return "PktMon API: N/D - caricamento DLL di sistema, Win32 " + Marshal.GetLastWin32Error();
+   try {
+    string[] names={"PacketMonitorInitialize","PacketMonitorUninitialize","PacketMonitorCreateLiveSession","PacketMonitorEnumDataSources","PacketMonitorCreateRealtimeStream","PacketMonitorAddSingleDataSourceToSession","PacketMonitorAttachOutputToSession","PacketMonitorSetSessionActive","PacketMonitorCloseSessionHandle","PacketMonitorCloseRealtimeStream"};
+    var missing=new System.Collections.Generic.List<string>();
+    foreach(string name in names) if(GetProcAddress(module,name)==IntPtr.Zero) missing.Add(name);
+    return missing.Count==0 ? "PktMon API: tutti i 10 export richiesti presenti; motore non avviato." : "PktMon API: export mancanti: " + string.Join(", ",missing.ToArray());
+   } finally {FreeLibrary(module);}
+  }
+  public static string Wlan() {
+   IntPtr client=IntPtr.Zero, list=IntPtr.Zero; uint version;
+   try {
+    uint error=WlanOpenHandle(2,IntPtr.Zero,out version,out client);
+    if(error!=0) return "WLAN OpenHandle: Win32 " + error + " - " + new Win32Exception((int)error).Message;
+    error=WlanEnumInterfaces(client,IntPtr.Zero,out list);
+    if(error!=0) return "WLAN EnumInterfaces: Win32 " + error + " - " + new Win32Exception((int)error).Message;
+    if(list==IntPtr.Zero) return "WLAN: N/D - tabella mancante.";
+    int count=Marshal.ReadInt32(list);
+    if(count<0 || count>16) return "WLAN: N/D - conteggio fuori limite.";
+    return "WLAN API: " + count + " interfacce restituite; cache BSS e permesso Posizione non verificati.";
+   } finally {if(list!=IntPtr.Zero) WlanFreeMemory(list); if(client!=IntPtr.Zero) WlanCloseHandle(client,IntPtr.Zero);}
+  }
+ }
+}
+'@
+    }
+    Add-Result ([ProcessLensSetup.NativeCheck]::Wlan())
+    Add-Result ([ProcessLensSetup.NativeCheck]::Exports((Join-Path $env:SystemRoot 'System32\pktmonapi.dll')))
+} catch { Add-Result ('Verifica API native: N/D - ' + $_.Exception.Message) }
+$reader = $null; $record = $null
+try {
+    $query = New-Object System.Diagnostics.Eventing.Reader.EventLogQuery('Security', [System.Diagnostics.Eventing.Reader.PathType]::LogName, '*')
+    $query.ReverseDirection = $true
+    $reader = New-Object System.Diagnostics.Eventing.Reader.EventLogReader($query)
+    $record = $reader.ReadEvent([TimeSpan]::FromSeconds(1))
+    Add-Result 'Registro Security: lettura consentita. Contenuto degli eventi non salvato.'
+} catch { Add-Result ('Registro Security: N/D - ' + $_.Exception.Message) }
+finally { if ($record) { $record.Dispose() }; if ($reader) { $reader.Dispose() } }
+$auditpol = Join-Path $env:SystemRoot 'System32\auditpol.exe'
+foreach ($guid in @('{0CCE9226-69AE-11D9-BED3-505054503030}', '{0CCE9215-69AE-11D9-BED3-505054503030}')) {
+    try {
+        Add-Result ('Audit in sola lettura: ' + $guid)
+        $text = @(& $auditpol /get "/subcategory:$guid" 2>&1)
+        $exitCode = $LASTEXITCODE
+        foreach ($line in ($text | Select-Object -First 16)) { Add-Result ([string]$line) }
+        Add-Result ('Auditpol exit code: ' + $exitCode)
+    } catch { Add-Result ('Audit: N/D - ' + $_.Exception.Message) }
+}
+Add-Result ''
+Add-Result 'PROSSIMI CONTROLLI'
+Add-Result 'Wi-Fi assente: verificare scheda, driver del produttore e WLAN AutoConfig. Un installer non aggiunge una scheda radio.'
+Add-Result 'Wi-Fi accesso negato: Impostazioni > Privacy e sicurezza > Posizione. Amministratore non sostituisce il consenso.'
+Add-Result 'PktMon export assenti: dipendono dalla versione di Windows; non copiare DLL da altri PC. La cattura IPv4 locale e separata.'
+Add-Result 'Segnali Windows: audit disabilitato o registro non accessibile non significa nessun tentativo di accesso.'
+Add-Result 'In ProcessLens: Elenca sorgenti Windows > seleziona sorgente > Cattura per 20 s; per Wi-Fi usa Leggi reti Wi-Fi e Cache radio Wi-Fi.'
+Add-Result 'Nessuno di questi controlli conta tutti i client del router o dimostra che qualcuno stia spiando un IP.'
+$logRoot = Join-Path $env:LOCALAPPDATA 'ProcessLens\logs'
+New-Item -ItemType Directory -Path $logRoot -Force | Out-Null
+$report = Join-Path $logRoot 'rete-prerequisiti.txt'
+[IO.File]::WriteAllLines($report, $lines, (New-Object Text.UTF8Encoding($true)))
+Write-Host ('Rapporto: ' + $report) -ForegroundColor Cyan
+if (-not $NoPrompt) {
+    $answer = Read-Host 'P: apri Posizione | S: apri Servizi | A: ripeti come amministratore | Invio: termina'
+    switch ($answer.ToUpperInvariant()) {
+        'P' { Start-Process 'ms-settings:privacy-location' }
+        'S' { Start-Process (Join-Path $env:SystemRoot 'System32\services.msc') }
+        'A' {
+            if (-not $admin) {
+                $ps = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
+                Start-Process -FilePath $ps -Verb RunAs -ArgumentList ('-NoProfile -ExecutionPolicy Bypass -File "' + $PSCommandPath + '"')
+            }
+        }
+    }
+}
diff --git a/setup/install-offline.ps1 b/setup/install-offline.ps1
new file mode 100644
index 0000000..c6d4752
--- /dev/null
+++ b/setup/install-offline.ps1
@@ -0,0 +1,77 @@
+$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot 'offline-common.ps1')
+if ($env:OS -ne 'Windows_NT' -or -not [Environment]::Is64BitProcess -or $env:PROCESSOR_ARCHITECTURE -ne 'AMD64') {
+    throw 'Questo pacchetto richiede Windows x64 e PowerShell a 64 bit. ARM64 e x86 non supportati.'
+}
+$sourceRoot = Split-Path -Parent $PSScriptRoot
+$installRoot = Get-ProcessLensInstallRoot
+$logRoot = Join-Path $env:LOCALAPPDATA 'ProcessLens\logs'
+New-Item -ItemType Directory -Path $logRoot -Force | Out-Null
+$transcriptStarted = $false
+try {
+    Start-Transcript -LiteralPath (Join-Path $logRoot 'installazione-r20.txt') -Force | Out-Null
+    $transcriptStarted = $true
+    Write-Host '[1/5] Verifica integrita del pacchetto completo...'
+    $manifest = Test-ProcessLensBundle $sourceRoot
+    if (@(Get-Process -Name ProcessLens -ErrorAction SilentlyContinue).Count -gt 0) {
+        throw 'Chiudi ProcessLens prima di installare. Nessun processo e stato terminato.'
+    }
+    Set-Location -LiteralPath $sourceRoot
+    $marker = Join-Path $installRoot 'processlens-owned-r20.txt'
+    if ((Test-Path -LiteralPath $installRoot) -and
+        (-not (Test-Path -LiteralPath $marker) -or (Get-Content -LiteralPath $marker -Raw).Trim() -ne $manifest.bundle)) {
+        throw 'La cartella di destinazione esiste e non appartiene a questa installazione. Nessun file sovrascritto.'
+    }
+    New-Item -ItemType Directory -Path $installRoot -Force | Out-Null
+    Set-Content -LiteralPath $marker -Value $manifest.bundle -Encoding ASCII
+    Write-Host '[2/5] Preparazione .NET SDK e Desktop Runtime privati...'
+    $sdkZip = Join-Path $PSScriptRoot 'payload\dotnet-sdk-8.0.426-win-x64.zip'
+    if ((Get-FileHash -LiteralPath $sdkZip -Algorithm SHA512).Hash -ne $manifest.sdk_sha512) { throw 'SHA512 Microsoft SDK non corrispondente.' }
+    $dotnetRoot = Join-Path $installRoot 'dotnet'
+    Expand-Archive -LiteralPath $sdkZip -DestinationPath $dotnetRoot -Force
+    Set-ProcessLensDotnetEnvironment $installRoot
+    $dotnet = Join-Path $dotnetRoot 'dotnet.exe'
+    $version = & $dotnet --version
+    if ($LASTEXITCODE -ne 0 -or "$version".Trim() -ne '8.0.426') { throw 'SDK privato non avviabile. Vedere il log.' }
+    # Configuration local to the extracted project; no user/machine NuGet settings changed.
+    $feed = [Security.SecurityElement]::Escape((Join-Path $PSScriptRoot 'payload\nuget'))
+    $config = '<?xml version="1.0" encoding="utf-8"?><configuration><packageSources><clear/><add key="ProcessLensOffline" value="' + $feed + '"/></packageSources><disabledPackageSources><clear/></disabledPackageSources></configuration>'
+    $configPath = Join-Path $sourceRoot 'NuGet.Config'
+    if ((Test-Path -LiteralPath $configPath) -and (Get-Content -LiteralPath $configPath -Raw).Trim() -ne $config) {
+        throw 'NuGet.Config esistente e diverso: estrai il pacchetto in una nuova cartella.'
+    }
+    Set-Content -LiteralPath $configPath -Value $config -Encoding UTF8
+    Write-Host '[3/5] Test completi e compilazione WPF. Puo richiedere diversi minuti...'
+    & (Join-Path $sourceRoot 'build-dashboard.ps1')
+    if (-not (Test-Path -LiteralPath (Join-Path $sourceRoot 'publish\win-x64\ProcessLens.exe'))) { throw 'Build senza eseguibile GUI.' }
+    Write-Host '[4/5] Installazione applicazione e collegamenti...'
+    $appRoot = Join-Path $installRoot 'app'
+    New-Item -ItemType Directory -Path $appRoot -Force | Out-Null
+    Copy-Item -Path (Join-Path $sourceRoot 'publish\*') -Destination $appRoot -Recurse -Force
+    Copy-Item -LiteralPath (Join-Path $PSScriptRoot 'start-installed.ps1') -Destination $installRoot -Force
+    Copy-Item -LiteralPath (Join-Path $PSScriptRoot 'offline-common.ps1') -Destination $installRoot -Force
+    Copy-Item -LiteralPath (Join-Path $PSScriptRoot 'diagnose-network.ps1') -Destination $installRoot -Force
+    $shell = New-Object -ComObject WScript.Shell
+    $menu = Join-Path ([Environment]::GetFolderPath('Programs')) 'ProcessLens'
+    New-Item -ItemType Directory -Path $menu -Force | Out-Null
+    $powershell = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
+    foreach ($item in @(@{ Name='ProcessLens'; Script='start-installed.ps1' }, @{ Name='ProcessLens - Diagnostica rete'; Script='diagnose-network.ps1' })) {
+        $link = $shell.CreateShortcut((Join-Path $menu ($item.Name + '.lnk')))
+        $link.TargetPath = $powershell
+        $scriptPath = Join-Path $installRoot $item.Script
+        $link.Arguments = '-NoProfile -ExecutionPolicy Bypass -File "' + $scriptPath + '"'
+        $link.WorkingDirectory = $installRoot
+        $link.Save()
+    }
+    Write-Host '[5/5] Installazione completata. Nessun servizio o criterio audit modificato.' -ForegroundColor Green
+    Write-Host 'Apri ProcessLens dal menu Start. Windows mostrera la richiesta amministratore.'
+    Write-Host 'Per i problemi rete usa DIAGNOSTICA_RETE.cmd o ProcessLens - Diagnostica rete nel menu Start.'
+    Write-Host 'Wi-Fi: verifica anche Privacy e sicurezza > Posizione e il servizio WLAN AutoConfig.'
+    Write-Host 'Le dipendenze sono locali. La verifica vulnerabilita online NuGet non e stata eseguita.'
+} catch {
+    Write-Host ('[INSTALLAZIONE INTERROTTA] ' + $_.Exception.Message) -ForegroundColor Red
+    Write-Host ('Log: ' + (Join-Path $logRoot 'installazione-r20.txt'))
+    throw
+} finally {
+    if ($transcriptStarted) { Stop-Transcript | Out-Null }
+}
diff --git a/setup/offline-common.ps1 b/setup/offline-common.ps1
new file mode 100644
index 0000000..0339eef
--- /dev/null
+++ b/setup/offline-common.ps1
@@ -0,0 +1,36 @@
+$ErrorActionPreference = 'Stop'
+function Get-ProcessLensInstallRoot {
+    if (-not $env:LOCALAPPDATA) { throw 'LOCALAPPDATA non disponibile.' }
+    return Join-Path $env:LOCALAPPDATA 'Programs\ProcessLens\R20'
+}
+function Test-ProcessLensBundle([string] $Root) {
+    $manifestPath = Join-Path $Root 'setup\bundle-manifest.json'
+    $manifest = Get-Content -LiteralPath $manifestPath -Raw -Encoding UTF8 | ConvertFrom-Json
+    if ($manifest.schema -ne 1 -or $manifest.bundle -ne 'ProcessLens-R20-win-x64-offline') { throw 'Manifest del pacchetto non valido.' }
+    $prefix = [IO.Path]::GetFullPath($Root).TrimEnd([IO.Path]::DirectorySeparatorChar) + [IO.Path]::DirectorySeparatorChar
+    foreach ($entry in $manifest.files) {
+        $relative = [string]$entry.file
+        if ([IO.Path]::IsPathRooted($relative) -or $relative -match '(^|[\\/])\.\.([\\/]|$)') { throw 'Percorso non valido nel manifest.' }
+        $full = [IO.Path]::GetFullPath((Join-Path $Root $relative))
+        if (-not $full.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase)) { throw 'File esterno al pacchetto.' }
+        if (-not (Test-Path -LiteralPath $full -PathType Leaf)) { throw "File mancante: $relative" }
+        if ((Get-FileHash -LiteralPath $full -Algorithm SHA256).Hash -ne $entry.sha256) { throw "File modificato o incompleto: $relative" }
+    }
+    return $manifest
+}
+function Set-ProcessLensDotnetEnvironment([string] $InstallRoot) {
+    $env:DOTNET_ROOT = Join-Path $InstallRoot 'dotnet'
+    $env:DOTNET_ROOT_X64 = $env:DOTNET_ROOT
+    $env:PATH = $env:DOTNET_ROOT + [IO.Path]::PathSeparator + $env:PATH
+    $env:DOTNET_MULTILEVEL_LOOKUP = '0'
+    $env:DOTNET_SKIP_FIRST_TIME_EXPERIENCE = '1'
+    $env:DOTNET_CLI_TELEMETRY_OPTOUT = '1'
+    $env:DOTNET_GENERATE_ASPNET_CERTIFICATE = 'false'
+    $env:NUGET_CERT_REVOCATION_MODE = 'offline'
+    $env:DOTNET_CLI_HOME = Join-Path $InstallRoot 'cli-home'
+    $env:NUGET_PACKAGES = Join-Path $InstallRoot 'packages'
+    $env:NuGetAudit = 'false' # Offline install only; no online vulnerability audit is claimed.
+    $env:MSBUILDDISABLENODEREUSE = '1'
+    $env:DOTNET_CLI_DO_NOT_USE_MSBUILD_SERVER = '1'
+    $env:UseSharedCompilation = 'false'
+}
diff --git a/setup/start-installed.ps1 b/setup/start-installed.ps1
new file mode 100644
index 0000000..ea97246
--- /dev/null
+++ b/setup/start-installed.ps1
@@ -0,0 +1,14 @@
+$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot 'offline-common.ps1')
+$installRoot = if (Test-Path -LiteralPath (Join-Path $PSScriptRoot 'processlens-owned-r20.txt')) { $PSScriptRoot } else { Get-ProcessLensInstallRoot }
+$exe = Join-Path $installRoot 'app\win-x64\ProcessLens.exe'
+if (-not (Test-Path -LiteralPath $exe)) { throw 'ProcessLens non installato. Esegui INSTALLA_PROCESSLENS.cmd.' }
+$admin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
+if (-not $admin) {
+    $ps = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
+    $script = Join-Path $installRoot 'start-installed.ps1'
+    Start-Process -FilePath $ps -Verb RunAs -ArgumentList ('-NoProfile -ExecutionPolicy Bypass -File "' + $script + '"')
+    exit
+}
+Set-ProcessLensDotnetEnvironment $installRoot
+Start-Process -FilePath $exe -WorkingDirectory (Split-Path -Parent $exe)
