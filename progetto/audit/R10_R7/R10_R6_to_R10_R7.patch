+namespace ProcessLens.Core;
+
+/// <summary>Case-insensitive file-path cache with a hard entry limit. Evicted metadata is read again.</summary>
+public sealed class BoundedMetadataCache<TValue>
+{
+    private readonly int _capacity;
+    private readonly Dictionary<string, TValue> _entries = new(StringComparer.OrdinalIgnoreCase);
+    public BoundedMetadataCache(int capacity)
+    {
+        if (capacity <= 0) throw new ArgumentOutOfRangeException(nameof(capacity));
+        _capacity = capacity;
+    }
+    public int Count => _entries.Count;
+    public bool TryGetValue(string path, out TValue value) => _entries.TryGetValue(path, out value!);
+    public TValue this[string path]
+    {
+        set
+        {
+            if (!_entries.ContainsKey(path) && _entries.Count == _capacity)
+                _entries.Remove(_entries.Keys.First());
+            _entries[path] = value;
+        }
+    }
+}
