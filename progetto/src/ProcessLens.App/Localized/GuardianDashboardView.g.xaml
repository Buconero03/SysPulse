                            <DataGrid.Columns>
                                <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 4926B5A86FD65D5D}" Binding="{Binding LocalTime}" Width="170"/>
                                <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr B348AF6C7FC06D6F}" Binding="{Binding Source}" Width="110"/>
                                <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 02B4EAB46F86935B}" Binding="{Binding Message}" Width="*"/>
