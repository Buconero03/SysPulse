+internal enum TrayActivation { Minimize, Restore }
+internal sealed class TrayActivationGate
+{
+    private double? _lastActivation;
+    public TrayActivation? Activate(double now, double doubleClickSeconds, bool visible, bool minimized)
+    {
+        if (!double.IsFinite(now) || !double.IsFinite(doubleClickSeconds) || doubleClickSeconds < 0) return null;
+        if (_lastActivation.HasValue && now >= _lastActivation.Value && now - _lastActivation.Value <= doubleClickSeconds) return null;
+        _lastActivation = now;
+        return visible && !minimized ? TrayActivation.Minimize : TrayActivation.Restore;
+    }
+}
diff --git a/progetto/src/ProcessLens.Core/ProcessGrouping.cs b/progetto/src/ProcessLens.Core/ProcessGrouping.cs
new file mode 100644
index 0000000..8ec41f0
--- /dev/null
+++ b/progetto/src/ProcessLens.Core/ProcessGrouping.cs
@@ -0,0 +1,62 @@
+namespace ProcessLens.Core;
+
+public sealed record ProcessFamily(string Key, ProcessSnapshot Root, IReadOnlyList<ProcessSnapshot> Members);
+
+/// <summary>Display grouping, not Windows Task Manager's undocumented application grouping.</summary>
+public static class ProcessGrouping
+{
+    public static bool IdentityMatches(ProcessSnapshot expected, ProcessSnapshot actual) =>
+        expected.Pid == actual.Pid && expected.StartTime.HasValue && actual.StartTime.HasValue &&
+        expected.StartTime.Value.ToUniversalTime() == actual.StartTime.Value.ToUniversalTime() && SameExecutable(expected, actual);
+    public static bool SameExecutable(ProcessSnapshot a, ProcessSnapshot b) =>
+        !string.IsNullOrWhiteSpace(a.ExecutablePath) && !string.IsNullOrWhiteSpace(b.ExecutablePath) &&
+        string.Equals(a.ExecutablePath, b.ExecutablePath, StringComparison.OrdinalIgnoreCase) &&
+        string.Equals(a.Name, b.Name, StringComparison.OrdinalIgnoreCase);
+    public static IReadOnlyList<ProcessFamily> Build(IReadOnlyCollection<ProcessSnapshot> processes)
+    {
+        var byPid = processes.GroupBy(p => p.Pid).Where(g => g.Count() == 1).ToDictionary(g => g.Key, g => g.Single());
+        int Root(ProcessSnapshot p)
+        {
+            int current = p.Pid; var seen = new HashSet<int>();
+            while (seen.Add(current) && byPid.TryGetValue(current, out var child) &&
+                byPid.TryGetValue(child.ParentPid, out var parent) && SameExecutable(child, parent) &&
+                child.StartTime.HasValue && parent.StartTime.HasValue &&
+                parent.StartTime.Value.ToUniversalTime() <= child.StartTime.Value.ToUniversalTime())
+            {
+                if (seen.Contains(parent.Pid)) return p.Pid; // A cycle is not a verified lineage.
+                current = parent.Pid;
+            }
+            return current;
+        }
+        return byPid.Values.GroupBy(Root).Select(g =>
+        {
+            var root = byPid[g.Key];
+            string key = $"{root.Pid}:{root.StartTime?.ToUniversalTime().Ticks}:{root.ExecutablePath?.ToUpperInvariant()}";
+            return new ProcessFamily(key, root, g.OrderBy(p => p.Pid == root.Pid ? 0 : 1).ThenBy(p => p.Pid).ToArray());
+        }).ToArray();
+    }
+}
+
+public static class ProcessIdentitySearch
+{
+    // Visible app name and executable only; excludes parent, arguments, product aliases and technical explanations.
+    public static bool Matches(ProcessSnapshot p, string? query, string? displayName = null)
+    {
+        string text = query?.Trim() ?? "";
+        if (text.Length == 0) return true;
+        if (text.All(char.IsAsciiDigit)) return p.Pid.ToString(System.Globalization.CultureInfo.InvariantCulture) == text;
+        return p.Name.Contains(text, StringComparison.OrdinalIgnoreCase) ||
+            (displayName ?? p.FileDescription ?? p.Name).Contains(text, StringComparison.OrdinalIgnoreCase);
+    }
+}
+
+public sealed record ProcessGroupUsage(double CpuPercent, int CpuKnown, double MemoryMb, int MemoryKnown, bool PrivateResident, int Count)
+{
+    public static ProcessGroupUsage From(IEnumerable<ProcessSnapshot> source)
+    {
+        var rows = source.ToArray(); bool privateResident = rows.Any(x => x.PrivateWorkingSetAvailable);
+        return new(rows.Where(x => x.CpuSampleAvailable).Sum(x => x.CpuPercent), rows.Count(x => x.CpuSampleAvailable),
+            rows.Sum(x => privateResident ? x.PrivateWorkingSetAvailable ? x.PrivateWorkingSetMb : 0 : x.WorkingSetAvailable ? x.WorkingSetMb : 0),
+            rows.Count(x => privateResident ? x.PrivateWorkingSetAvailable : x.WorkingSetAvailable), privateResident, rows.Length);
