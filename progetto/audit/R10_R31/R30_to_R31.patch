+r=a.project.resolve();shell=a.shell.resolve();audit=r/'audit/R10_R31';sha=lambda b:hashlib.sha256(b).hexdigest()
+# Same 30 authorized baseline source stages, plus the R24 wiring gate.
+stages=[x['file'] for x in json.loads((r/'audit/R10_R23_R1/powershell-evidence.json').read_text())['stages']]+['audit/tools/check_live_metrics_r24.ps1','audit/tools/check_process_groups_r25.ps1','audit/tools/check_scroll_minimize_r26.ps1','audit/tools/check_windows_icons_r27.ps1','audit/tools/check_window_controls_r28.ps1','audit/tools/check_window_diagnostics_r29.ps1','audit/tools/check_tray_callbacks_r30.ps1','audit/tools/check_search_hosts_r31.ps1'];results=[];logs=[]
