<UserControl x:Class="ProcessLens.App.GuardianDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l10n="clr-namespace:ProcessLens.App"
             xmlns:local="clr-namespace:ProcessLens.App"
             Background="#F5F6F8" FontFamily="Segoe UI" Foreground="#202124">
    <UserControl.Resources>
        <Style x:Key="GuardianCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E5E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="GuardianTable" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E9EDF2"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="ColumnHeaderHeight" Value="37"/>
        </Style>
        <Style x:Key="GuardianHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>
        <Style x:Key="GuardianNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#173F68"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style x:Key="SelectableGuardianNumber" TargetType="local:SelectableText">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#173F68"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style x:Key="GuardianTab" TargetType="TabItem">
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Margin" Value="0,0,6,5"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="#D6DFEA"
                                BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#DFEBFC"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#7098CE"/>
                                <Setter Property="Foreground" Value="#173F68"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#174E8F"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <l10n:LocalizedTextBlock Text="{l10n:Tr 1DF9B13CAF76AD33}" FontSize="21" FontWeight="SemiBold"/>
                <l10n:LocalizedTextBlock Text="{l10n:Tr 17055810F375DAD8}"
                           FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <l10n:LocalizedTextBlock Text="{l10n:Tr B74EC82EEC75A186}" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,7,0"/>
                <ComboBox x:Name="WindowSelector" Width="115" Height="32" SelectedIndex="2"
                          SelectionChanged="WindowSelector_SelectionChanged" Margin="0,0,9,0">
                    <l10n:LocalizedComboBoxItem Content="{l10n:Tr 192DBBB86F443043}" Tag="5"/>
                    <l10n:LocalizedComboBoxItem Content="{l10n:Tr 4FDB406CEFAF0E96}" Tag="15"/>
                    <l10n:LocalizedComboBoxItem Content="{l10n:Tr EA713BC71B055EE5}" Tag="30"/>
                    <l10n:LocalizedComboBoxItem Content="{l10n:Tr D742C6337A698F38}" Tag="60"/>
                </ComboBox>
                <l10n:LocalizedButton Content="{l10n:Tr 86FAA2A23AEE1664}" Padding="15,7" Background="#DFEDFF"
                        BorderBrush="#B9D1ED" Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,-10,12">
            <Border Style="{StaticResource GuardianCard}">
                <StackPanel><l10n:LocalizedTextBlock Text="{l10n:Tr 67A0CD1997B13574}" Style="{StaticResource GuardianHeading}"/>
                    <local:SelectableText x:Name="StartedValue" Text="{l10n:Tr BDA050585A00F0F6}" Style="{StaticResource SelectableGuardianNumber}"/>
                    <l10n:LocalizedTextBlock Text="{l10n:Tr 9183DB490D7FEE26}" Foreground="#64748B" FontSize="10"/></StackPanel>
            </Border>
            <Border Style="{StaticResource GuardianCard}">
                <StackPanel><l10n:LocalizedTextBlock Text="{l10n:Tr F9758266A6EA6669}" Style="{StaticResource GuardianHeading}"/>
                    <local:SelectableText x:Name="ExitedValue" Text="{l10n:Tr BDA050585A00F0F6}" Style="{StaticResource SelectableGuardianNumber}"/>
                    <l10n:LocalizedTextBlock Text="{l10n:Tr FBA67CEC39483F58}" Foreground="#64748B" FontSize="10"/></StackPanel>
            </Border>
            <Border Style="{StaticResource GuardianCard}">
                <StackPanel><l10n:LocalizedTextBlock Text="{l10n:Tr 1BF2BD5D9CF42D9E}" Style="{StaticResource GuardianHeading}"/>
                    <local:SelectableText x:Name="EtwValue" Text="{l10n:Tr BDA050585A00F0F6}" Style="{StaticResource SelectableGuardianNumber}"/>
                    <l10n:LocalizedTextBlock Text="{l10n:Tr E030FF216426486F}" Foreground="#64748B" FontSize="10"/></StackPanel>
            </Border>
            <Border Style="{StaticResource GuardianCard}">
                <StackPanel><l10n:LocalizedTextBlock Text="{l10n:Tr 6D4813F39C05AE46}" Style="{StaticResource GuardianHeading}"/>
                    <local:SelectableText x:Name="TotalValue" Text="{l10n:Tr BDA050585A00F0F6}" Style="{StaticResource SelectableGuardianNumber}"/>
                    <l10n:LocalizedTextBlock Text="{l10n:Tr 08B02F746F567C94}" Foreground="#64748B" FontSize="10"/></StackPanel>
            </Border>
            <Border Style="{StaticResource GuardianCard}">
                <StackPanel><l10n:LocalizedTextBlock Text="{l10n:Tr D10A7890DC2E212C}" Style="{StaticResource GuardianHeading}"/>
                    <local:SelectableText x:Name="StorageValue" Text="{l10n:Tr BDA050585A00F0F6}" Style="{StaticResource SelectableGuardianNumber}"/>
                    <l10n:LocalizedTextBlock Text="{l10n:Tr 786B74673398D689}" Foreground="#64748B" FontSize="10"/></StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="#EEF4FB" CornerRadius="8" BorderBrush="#D8E4F2"
                BorderThickness="1" Padding="11,9" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <local:SelectableText x:Name="StatusText" Text="{l10n:Tr 6BB21E8E5F028DB8}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#234970" FontSize="12"/>
                <local:SelectableText x:Name="UpdatedText" Grid.Column="1" Text="{l10n:Tr BDA050585A00F0F6}"
                           VerticalAlignment="Center" Foreground="#64748B" FontSize="11" Margin="14,0,0,0"/>
            </Grid>
        </Border>

