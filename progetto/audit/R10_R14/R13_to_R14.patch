diff --git a/src/ProcessLens.App/SystemProcessesView.xaml.cs b/src/ProcessLens.App/SystemProcessesView.xaml.cs
new file mode 100644
index 0000000..351f3d5
--- /dev/null
+++ b/src/ProcessLens.App/SystemProcessesView.xaml.cs
@@ -0,0 +1,132 @@
+using System.Globalization;
+using System.Windows;
+using System.Windows.Controls;
+using ProcessLens.Core;
+using ProcessLens.Windows;
+
+namespace ProcessLens.App;
+
+public sealed record SystemProcessRow(SystemProcessEntry Entry, string WindowsDirectory)
+{
+    public int Pid => Entry.Pid;
+    public string Name => Entry.Name;
+    public int Parent => Entry.ParentPid;
+    public string Origin => SystemProcessPresentation.Origin(Entry, WindowsDirectory);
+    public string Resident => SystemProcessPresentation.MiB(Entry.WorkingSetBytes);
+    public string Threads => Entry.Threads?.ToString(CultureInfo.CurrentCulture) ?? "N/D";
+    public string Handles => Entry.Handles?.ToString(CultureInfo.CurrentCulture) ?? "N/D";
+    public string Session => Entry.Session?.ToString(CultureInfo.CurrentCulture) ?? "N/D";
+    public string Access => Entry.Access;
+}
+
+public partial class SystemProcessesView : UserControl
+{
+    private readonly ISystemProcessSource _source;
+    private readonly string _windowsDirectory;
+    private bool _active, _busy;
+    private int _generation;
+    private CancellationTokenSource? _operation;
+    private SystemProcessCatalog? _catalog;
+    public event Action<SystemProcessEntry>? AnalysisRequested;
+    public SystemProcessesView() : this(new WindowsSystemProcessSource(),
+        Environment.GetFolderPath(Environment.SpecialFolder.Windows)) { }
+    internal SystemProcessesView(ISystemProcessSource source, string windowsDirectory)
+    {
+        _source = source; _windowsDirectory = windowsDirectory;
+        InitializeComponent(); UpdateButtons(); // No native query and no timer here.
+    }
+    public void SetActive(bool active)
+    {
+        if (_active == active) return;
+        _active = active;
+        if (!active)
+        {
+            _generation++; _operation?.Cancel(); _catalog = null;
+            SystemProcessesTable.ItemsSource = null;
+            SystemStatusText.Text = "Elenco da aggiornare.";
+            SystemMemoryText.Text = "Memoria: N/D";
+            SystemSourceText.Text = "Nessuna lettura corrente.";
+            SystemSelectionText.Text = "Seleziona una riga dopo l'aggiornamento.";
+        }
+        UpdateButtons();
+    }
+    internal async Task RefreshAsync()
+    {
+        if (!_active || _busy) return;
+        _busy = true; int generation = _generation;
+        using var operation = new CancellationTokenSource(); _operation = operation;
+        _catalog = null; SystemProcessesTable.ItemsSource = null;
+        SystemStatusText.Text = "Lettura dei processi di sistema…";
+        SystemMemoryText.Text = "Memoria: N/D"; SystemSourceText.Text = "Lettura in corso.";
+        SystemSelectionText.Text = "Seleziona una riga dopo l'aggiornamento.";
+        UpdateButtons();
+        try
+        {
+            var result = await Task.Run(() => _source.Capture(operation.Token), operation.Token);
+            if (!_active || generation != _generation || operation.IsCancellationRequested) return;
+            _catalog = result;
+            SystemMemoryText.Text = SystemProcessPresentation.MemoryReport(result.Memory);
+            SystemSourceText.Text = result.Source + "\n" + result.Note;
+            ApplyFilter();
+        }
+        catch (OperationCanceledException) { }
+        catch (Exception ex)
+        {
+            if (_active && generation == _generation)
+            { SystemStatusText.Text = "Lettura non disponibile."; SystemSourceText.Text = ex.Message; }
+        }
+        finally
+        {
+            if (ReferenceEquals(_operation, operation)) _operation = null;
+            _busy = false; UpdateButtons();
+        }
+    }
+    private void ApplyFilter()
+    {
+        if (SystemProcessesTable is null || _catalog is null) return;
+        var c = _catalog;
+        if (!c.Available)
+        { SystemProcessesTable.ItemsSource = null; SystemStatusText.Text = "Elenco non disponibile. Consulta i dettagli della lettura."; return; }
+        IEnumerable<SystemProcessEntry> rows = c.Processes;
+        if (SystemScopeBox.SelectedIndex == 0) rows = rows.Where(p => SystemProcessPresentation.WindowsGroup(p, _windowsDirectory));
+        if (SystemScopeBox.SelectedIndex == 2) rows = rows.Where(p => p.Path is null && p.Pid is not (0 or 4));
+        string search = SystemSearchBox.Text.Trim();
+        if (search.Length > 0)
+        {
+            if (search.All(char.IsAsciiDigit)) rows = rows.Where(p => p.Pid.ToString(CultureInfo.InvariantCulture) == search);
+            else rows = rows.Where(p => p.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
+        }
+        var visible = rows.OrderBy(p => p.Pid).Select(p => new SystemProcessRow(p, _windowsDirectory)).ToArray();
+        SystemProcessesTable.ItemsSource = visible;
+        SystemStatusText.Text = $"Campione {c.CapturedUtc.ToLocalTime():HH:mm:ss} · {visible.Length} mostrati / {c.Processes.Count} rilevati" +
+            (c.Partial ? " · fonte alternativa / dati parziali" : "") + " · aggiornamento manuale";
+        SystemSelectionText.Text = "Seleziona una riga per leggere i dettagli.";
+        UpdateButtons();
+    }
+    private void UpdateButtons()
+    {
+        RefreshSystemButton.IsEnabled = _active && !_busy;
+        CopySystemButton.IsEnabled = _active && !_busy && _catalog is not null;
+        AnalyzeSystemButton.IsEnabled = _active && !_busy && SystemProcessesTable.SelectedItem is SystemProcessRow { Entry.StartUtc: not null };
+    }
+    private async void RefreshSystem_Click(object sender, RoutedEventArgs e) => await RefreshAsync();
+    private void Scope_Changed(object sender, SelectionChangedEventArgs e) => ApplyFilter();
+    private void Search_Changed(object sender, TextChangedEventArgs e) => ApplyFilter();
+    private void SystemSelection_Changed(object sender, SelectionChangedEventArgs e)
+    {
+        if (AnalyzeSystemButton is null || SystemSelectionText is null) return;
+        SystemSelectionText.Text = SystemProcessesTable.SelectedItem is SystemProcessRow row
+            ? SystemProcessPresentation.Details(row.Entry, _windowsDirectory)
+            : "Seleziona una riga per leggere i dettagli.";
+        UpdateButtons();
+    }
+    private void AnalyzeSystem_Click(object sender, RoutedEventArgs e)
+    {
+        if (_active && !_busy && SystemProcessesTable.SelectedItem is SystemProcessRow { Entry.StartUtc: not null } row)
+            AnalysisRequested?.Invoke(row.Entry);
+    }
+    internal void ShowNavigationProblem(string text) => SystemSelectionText.Text = text;
+    private void CopySystem_Click(object sender, RoutedEventArgs e) => ClipboardText.Copy(this,
+        SystemStatusText.Text + "\n" + SystemSourceText.Text + "\n\n" + SystemMemoryText.Text + "\n\n" +
+        GridCopySupport.CaptureTable(SystemProcessesTable, false) + "\n\n" + SystemSelectionText.Text);
+}
diff --git a/src/ProcessLens.Core/SystemProcessCatalog.cs b/src/ProcessLens.Core/SystemProcessCatalog.cs
new file mode 100644
index 0000000..b45b7d0
--- /dev/null
+++ b/src/ProcessLens.Core/SystemProcessCatalog.cs
@@ -0,0 +1,74 @@
+using System.Globalization;
+
+namespace ProcessLens.Core;
+
+public sealed record SystemProcessEntry(int Pid, int ParentPid, string Name, uint? Threads,
+    uint? Handles, uint? Session, long? WorkingSetBytes, string? Path = null,
+    DateTime? StartUtc = null, string Access = "Dettagli non letti");
+public sealed record SystemMemorySnapshot(long? PhysicalTotal, long? PhysicalAvailable,
+    long? Commit, long? CommitLimit, long? KernelPaged, long? KernelNonpaged, string Note);
+public sealed record SystemProcessCatalog(DateTime CapturedUtc, bool Available, bool Partial,
+    string Source, string Note, IReadOnlyList<SystemProcessEntry> Processes, SystemMemorySnapshot Memory);
+public interface ISystemProcessSource
+{
+    SystemProcessCatalog Capture(CancellationToken cancellationToken);
+}
+
+// A navigation group is not an authenticity verdict. Name hints never certify Windows ownership.
+public static class SystemProcessPresentation
+{
+    private static readonly HashSet<string> Names = new(StringComparer.OrdinalIgnoreCase)
+    { "System", "System Idle Process", "Idle", "Memory Compression", "Registry", "Secure System",
+      "smss.exe", "csrss.exe", "wininit.exe", "services.exe", "lsass.exe", "winlogon.exe", "svchost.exe",
+      "dwm.exe", "fontdrvhost.exe", "sihost.exe", "explorer.exe", "MsMpEng.exe", "NisSrv.exe" };
+    public static bool InternalName(string name) => name.ToLowerInvariant() is "system" or "system idle process" or "idle" or
+        "memory compression" or "registry" or "secure system";
+    public static bool SameInstance(SystemProcessEntry entry, ProcessSnapshot process) =>
+        entry.Pid == process.Pid && entry.StartUtc.HasValue && process.StartTime.HasValue &&
+        entry.StartUtc.Value == process.StartTime.Value.ToUniversalTime() &&
+        entry.Name.Equals(process.Name, StringComparison.OrdinalIgnoreCase);
+    public static string Origin(SystemProcessEntry p, string windowsDirectory)
+    {
+        if (p.Pid is 0 or 4) return "Voce di sistema · PID riservato";
+        if (UnderWindows(p.Path, windowsDirectory)) return "Percorso nella cartella Windows";
+        if (Names.Contains(p.Name)) return "Nome tipico di Windows · origine non verificata";
+        return p.Path is null ? "Origine N/D" : "Percorso esterno a Windows";
+    }
+    public static bool WindowsGroup(SystemProcessEntry p, string windowsDirectory) =>
+        p.Pid is 0 or 4 || UnderWindows(p.Path, windowsDirectory) || Names.Contains(p.Name);
+    public static bool UnderWindows(string? path, string directory)
+    {
+        // Lexical grouping only: boundary + rooted paths + no traversal, junction or signature claims.
+        if (string.IsNullOrWhiteSpace(path) || directory.Length < 3 ||
+            !Rooted(path) || !Rooted(directory)) return false;
+        var parts = path.Replace('/', '\\').Split('\\');
+        if (parts.Any(x => x is "." or "..")) return false;
+        string prefix = directory.Replace('/', '\\').TrimEnd('\\') + "\\";
+        return path.Replace('/', '\\').StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
+    }
+    private static bool Rooted(string value) => value.Length > 2 && char.IsAsciiLetter(value[0]) &&
+        value[1] == ':' && value[2] is '\\' or '/';
+    public static string MiB(long? bytes) => bytes is >= 0
+        ? (bytes.Value / 1048576d).ToString("N1", CultureInfo.CurrentCulture) + " MiB" : "N/D";
+    public static string Role(SystemProcessEntry p) => p.Pid == 0
+        ? "Inattività CPU: voce contabile, non un'app in esecuzione."
+        : p.Pid == 4 ? "System: contiene attività in modalità kernel. I suoi contatori non rappresentano tutta la memoria del sistema."
+        : p.Name.Equals("Memory Compression", StringComparison.OrdinalIgnoreCase)
+            ? "Nome associato alla compressione delle pagine di memoria. Il Working Set della voce non misura la dimensione logica dei dati prima della compressione."
+        : p.Name.Equals("Registry", StringComparison.OrdinalIgnoreCase)
+            ? "Nome associato alla gestione del registro. Identità e operazione corrente non verificate dal solo nome."
+        : p.Name.Equals("Secure System", StringComparison.OrdinalIgnoreCase)
+            ? "Nome associato all'ambiente di sicurezza isolato di Windows. Non identifica tutti i servizi di sicurezza."
+        : "Per ruolo, CPU e servizi usa l'analisi della stessa istanza. Il nome e il percorso non verificano la firma digitale.";
+    public static string MemoryReport(SystemMemorySnapshot m) =>
+        $"RAM fisica totale: {MiB(m.PhysicalTotal)}\nRAM disponibile: {MiB(m.PhysicalAvailable)}\n" +
+        $"Memoria impegnata: {MiB(m.Commit)} / limite {MiB(m.CommitLimit)}\n" +
+        $"Pool kernel paginabile: {MiB(m.KernelPaged)}\nPool kernel non paginabile: {MiB(m.KernelNonpaged)}\n" +
+        "Il pool paginabile può trovarsi anche fuori dalla RAM. Questi contatori si sovrappongono ad altre viste: non sommarli ai Working Set.\n" + m.Note;
+    public static string Details(SystemProcessEntry p, string windowsDirectory) =>
+        $"{p.Name} · PID {p.Pid}\n{Role(p)}\n\nOrigine: {Origin(p, windowsDirectory)}\n" +
+        $"Percorso: {p.Path ?? "N/D"}\nAvvio UTC: {(p.StartUtc.HasValue ? p.StartUtc.Value.ToString("O") : "N/D")}\n" +
+        $"Accesso ai dettagli: {p.Access}\nWorking Set totale: {MiB(p.WorkingSetBytes)}\n" +
+        "Working Set totale: pagine residenti private e condivise; non equivale al Working Set privato.\n" +
+        "CPU istantanea e firma digitale non misurate in questa vista. La presenza nell'elenco non prova che il processo stia lavorando.";
+}
diff --git a/src/ProcessLens.Windows/WindowsSystemProcessSource.cs b/src/ProcessLens.Windows/WindowsSystemProcessSource.cs
new file mode 100644
index 0000000..89ca490
--- /dev/null
+++ b/src/ProcessLens.Windows/WindowsSystemProcessSource.cs
@@ -0,0 +1,219 @@
+using System.ComponentModel;
+using System.Runtime.InteropServices;
+using System.Text;
+using ProcessLens.Core;
+
+namespace ProcessLens.Windows;
+
+// On-demand, read-only inventory. The normal collector, CPU sampler and Guardian are unchanged.
+public sealed class WindowsSystemProcessSource : ISystemProcessSource
+{
+    public const int MaximumBuffer = 16 * 1024 * 1024, MaximumRows = 16384;
+    [StructLayout(LayoutKind.Sequential)]
+    internal struct UnicodeName { public ushort Length, MaximumLength; public IntPtr Buffer; }
+    // Published winternl layout. Reserved fields establish offsets; their contents are never used.
+    [StructLayout(LayoutKind.Sequential)]
+    internal struct ProcessInfo
+    {
+        public uint NextEntryOffset, NumberOfThreads;
+        [MarshalAs(UnmanagedType.ByValArray, SizeConst = 48)] public byte[] Reserved1;
+        public UnicodeName ImageName;
+        public int BasePriority;
+        public IntPtr UniqueProcessId, InheritedFromUniqueProcessId;
+        public uint HandleCount, SessionId;
+        public IntPtr Reserved3;
+        public UIntPtr PeakVirtualSize, VirtualSize;
+        public uint Reserved4;
+        public UIntPtr PeakWorkingSetSize, WorkingSetSize;
+        public IntPtr Reserved5;
+        public UIntPtr QuotaPagedPoolUsage;
+        public IntPtr Reserved6;
+        public UIntPtr QuotaNonPagedPoolUsage, PagefileUsage, PeakPagefileUsage, PrivatePageCount;
+        [MarshalAs(UnmanagedType.ByValArray, SizeConst = 6)] public long[] Reserved7;
+    }
+    [StructLayout(LayoutKind.Sequential)]
+    internal struct PerformanceInfo
+    {
+        public uint Size;
+        public UIntPtr CommitTotal, CommitLimit, CommitPeak, PhysicalTotal, PhysicalAvailable,
+            SystemCache, KernelTotal, KernelPaged, KernelNonpaged, PageSize;
+        public uint HandleCount, ProcessCount, ThreadCount;
+    }
+    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
+    private struct ToolhelpEntry
+    {
+        public uint Size, Usage, Pid;
+        public UIntPtr Heap;
+        public uint Module, Threads, Parent;
+        public int Priority;
+        public uint Flags;
+        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 260)] public string Name;
+    }
+    [DllImport("ntdll.dll", ExactSpelling = true)]
+    private static extern int NtQuerySystemInformation(int infoClass, IntPtr data, uint length, out uint required);
+    [DllImport("psapi.dll", SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static extern bool GetPerformanceInfo(ref PerformanceInfo data, uint size);
+    [DllImport("kernel32.dll", SetLastError = true)] private static extern IntPtr CreateToolhelp32Snapshot(uint flags, uint pid);
+    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, ExactSpelling = true, SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)] private static extern bool Process32FirstW(IntPtr snapshot, ref ToolhelpEntry entry);
+    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, ExactSpelling = true, SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)] private static extern bool Process32NextW(IntPtr snapshot, ref ToolhelpEntry entry);
+    [DllImport("kernel32.dll", SetLastError = true)] private static extern IntPtr OpenProcess(uint access, bool inherit, uint pid);
+    [DllImport("kernel32.dll")] [return: MarshalAs(UnmanagedType.Bool)] private static extern bool CloseHandle(IntPtr handle);
+    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, ExactSpelling = true, SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)] private static extern bool QueryFullProcessImageNameW(IntPtr handle, uint flags, StringBuilder path, ref uint size);
+    [DllImport("kernel32.dll", SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)] private static extern bool GetProcessTimes(IntPtr handle,
+        out long creation, out long exit, out long kernel, out long user);
+
+    public SystemProcessCatalog Capture(CancellationToken cancellationToken)
+    {
+        DateTime began = DateTime.UtcNow;
+        var memory = ReadMemory();
+        IReadOnlyList<SystemProcessEntry> rows;
+        string source = "NtQuerySystemInformation · SystemProcessInformation", note = "";
+        bool partial = false;
+        try { rows = ReadNative(cancellationToken); }
+        catch (OperationCanceledException) { throw; }
+        catch (Exception ex) when (ex is Win32Exception or InvalidDataException or EntryPointNotFoundException or DllNotFoundException)
+        {
+            note = "Inventario nativo non disponibile: " + ex.Message + "\nFonte alternativa Toolhelp; le voci interne possono differire.";
+            partial = true; source = "Toolhelp · elenco alternativo";
+            try { rows = ReadToolhelp(cancellationToken); }
+            catch (OperationCanceledException) { throw; }
+            catch (Exception fallback) when (fallback is Win32Exception or InvalidDataException)
+            { return new(began, false, true, source, note + "\n" + fallback.Message, Array.Empty<SystemProcessEntry>(), memory); }
+        }
+        var enriched = new List<SystemProcessEntry>(rows.Count);
+        foreach (var row in rows)
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            enriched.Add(ReadIdentity(row, began));
+        }
+        return new(began, true, partial, source, note, enriched, memory);
+    }
+
+    private static IReadOnlyList<SystemProcessEntry> ReadNative(CancellationToken cancellationToken)
+    {
+        int size = 256 * 1024;
+        for (int attempt = 0; attempt < 8; attempt++)
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            IntPtr buffer = Marshal.AllocHGlobal(size);
+            try
+            {
+                int status = NtQuerySystemInformation(5, buffer, (uint)size, out uint required);
+                if (status == unchecked((int)0xC0000004) || status == unchecked((int)0xC0000023))
+                {
+                    long next = Math.Max((long)size * 2, (long)required + 65536);
+                    if (next > MaximumBuffer) throw new InvalidDataException("Inventario oltre il limite di 16 MiB.");
+                    size = (int)next; continue;
+                }
+                if (status < 0) throw new InvalidDataException($"NtQuerySystemInformation: NTSTATUS 0x{status:X8}.");
+                if (required == 0 || required > size) throw new InvalidDataException("Dimensione dell'inventario non valida.");
+                return ParseNative(buffer, checked((int)required), cancellationToken);
+            }
+            finally { Marshal.FreeHGlobal(buffer); }
+        }
+        throw new InvalidDataException("Inventario variato durante la lettura; riprova.");
+    }
+    internal static IReadOnlyList<SystemProcessEntry> ParseNative(IntPtr buffer, int length, CancellationToken token)
+    {
+        int header = Marshal.SizeOf<ProcessInfo>(), offset = 0;
+        if (buffer == IntPtr.Zero || length < header || length > MaximumBuffer) throw new InvalidDataException("Buffer processi non valido.");
+        var rows = new List<SystemProcessEntry>(); var pids = new HashSet<int>();
+        while (true)
+        {
+            token.ThrowIfCancellationRequested();
+            if (offset > length - header || rows.Count >= MaximumRows) throw new InvalidDataException("Elenco processi troncato o troppo lungo.");
+            var row = Marshal.PtrToStructure<ProcessInfo>(IntPtr.Add(buffer, offset));
+            uint next = row.NextEntryOffset;
+            if (next != 0 && (next < header || next > length - offset - header || next % IntPtr.Size != 0))
+                throw new InvalidDataException("Offset processi non valido.");
+            int end = next == 0 ? length : offset + (int)next;
+            long pid = row.UniqueProcessId.ToInt64(), parent = row.InheritedFromUniqueProcessId.ToInt64();
+            if (pid < 0 || pid > int.MaxValue || parent < 0 || parent > int.MaxValue || !pids.Add((int)pid))
+                throw new InvalidDataException("PID non valido o ripetuto.");
+            var n = row.ImageName;
+            long nameOffset = n.Buffer.ToInt64() - buffer.ToInt64();
+            if ((n.Length & 1) != 0 || n.Length > 2048 || n.MaximumLength < n.Length ||
+                (n.Length > 0 && (nameOffset < offset + header || nameOffset > end - n.Length)))
+                throw new InvalidDataException("Nome processo fuori dal buffer.");
+            string name = n.Length == 0 ? (pid == 0 ? "System Idle Process" : "Nome N/D") :
+                Marshal.PtrToStringUni(n.Buffer, n.Length / 2) ?? "Nome N/D";
+            ulong workingSet = row.WorkingSetSize.ToUInt64();
+            long? resident = workingSet <= (ulong)long.MaxValue ? (long)workingSet : null;
+            // Some special entries expose zero placeholders; do not turn those into measured zero RAM.
+            if (workingSet == 0 && (pid is 0 or 4 || SystemProcessPresentation.InternalName(name))) resident = null;
+            rows.Add(new((int)pid, (int)parent, name, row.NumberOfThreads, row.HandleCount,
+                row.SessionId, resident));
+            if (next == 0) return rows;
+            offset += (int)next;
+        }
+    }
+    private static IReadOnlyList<SystemProcessEntry> ReadToolhelp(CancellationToken token)
+    {
+        IntPtr snapshot = CreateToolhelp32Snapshot(2, 0);
+        if (snapshot == new IntPtr(-1)) throw new Win32Exception(Marshal.GetLastWin32Error());
+        try
+        {
+            var entry = new ToolhelpEntry { Size = (uint)Marshal.SizeOf<ToolhelpEntry>(), Name = "" };
+            if (!Process32FirstW(snapshot, ref entry)) throw new Win32Exception(Marshal.GetLastWin32Error());
+            var rows = new List<SystemProcessEntry>();
+            do
+            {
+                token.ThrowIfCancellationRequested();
+                if (rows.Count >= MaximumRows || entry.Pid > int.MaxValue || entry.Parent > int.MaxValue)
+                    throw new InvalidDataException("Inventario Toolhelp oltre i limiti.");
+                rows.Add(new((int)entry.Pid, (int)entry.Parent, entry.Name, entry.Threads, null, null, null));
+            } while (Process32NextW(snapshot, ref entry));
+            int error = Marshal.GetLastWin32Error();
+            if (error != 18) throw new Win32Exception(error); // ERROR_NO_MORE_FILES is normal termination.
+            return rows;
+        }
+        finally { CloseHandle(snapshot); }
+    }
+    private static SystemProcessEntry ReadIdentity(SystemProcessEntry row, DateTime began)
+    {
+        if (row.Pid is 0 or 4) return row with { Access = "Voce di sistema; dettagli limitati" };
+        IntPtr handle = OpenProcess(0x1000, false, (uint)row.Pid); // QUERY_LIMITED_INFORMATION only.
+        if (handle == IntPtr.Zero) return row with { Access = "Dettagli N/D · Win32 " + Marshal.GetLastWin32Error() };
+        try
+        {
+            if (!GetProcessTimes(handle, out long creation, out _, out _, out _) || creation <= 0)
+                return row with { Access = "Avvio N/D; identità non verificabile" };
+            DateTime start;
+            try { start = DateTime.FromFileTimeUtc(creation); }
+            catch (ArgumentOutOfRangeException) { return row with { Access = "Avvio non valido" }; }
+            if (start > began) return row with { Access = "Istanza cambiata durante la lettura; aggiorna" };
+            var path = new StringBuilder(1024); uint chars = (uint)path.Capacity;
+            if (!QueryFullProcessImageNameW(handle, 0, path, ref chars))
+            {
+                int error = Marshal.GetLastWin32Error();
+                if (error != 122) return row with { Access = "Percorso N/D · Win32 " + error };
+                path = new StringBuilder(32768); chars = (uint)path.Capacity;
+                if (!QueryFullProcessImageNameW(handle, 0, path, ref chars))
+                    return row with { Access = "Percorso N/D · Win32 " + Marshal.GetLastWin32Error() };
+            }
+            string value = path.ToString();
+            if (!System.IO.Path.GetFileName(value).Equals(row.Name, StringComparison.OrdinalIgnoreCase))
+                return row with { Access = "Identità non verificabile dal percorso" };
+            return row with { Path = value, StartUtc = start, Access = "Percorso e avvio letti" };
+        }
+        finally { CloseHandle(handle); }
+    }
+    internal static long? PageBytes(ulong pages, ulong pageSize) => pageSize == 0 ||
+        pages > (ulong)long.MaxValue / pageSize ? null : (long)(pages * pageSize);
+    private static SystemMemorySnapshot ReadMemory()
+    {
+        var data = new PerformanceInfo { Size = (uint)Marshal.SizeOf<PerformanceInfo>() };
+        if (!GetPerformanceInfo(ref data, data.Size))
+            return new(null, null, null, null, null, null, "GetPerformanceInfo: Win32 " + Marshal.GetLastWin32Error());
+        ulong pageSize = data.PageSize.ToUInt64();
+        long? Bytes(UIntPtr pages) => PageBytes(pages.ToUInt64(), pageSize);
+        return new(Bytes(data.PhysicalTotal), Bytes(data.PhysicalAvailable), Bytes(data.CommitTotal),
+            Bytes(data.CommitLimit), Bytes(data.KernelPaged), Bytes(data.KernelNonpaged),
+            "Fonte: GetPerformanceInfo. Campione separato dall'inventario processi; non è una ripartizione esatta della RAM.");
+    }
+}
