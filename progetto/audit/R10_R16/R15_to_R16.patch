+namespace ProcessLens.Core;
+
+public sealed record NetworkAuditSetting(string Category, bool? FailuresEnabled, string Note)
+{
+    public string Text => Category + ": " + (FailuresEnabled is true ? "raccolta errori abilitata adesso" :
+        FailuresEnabled is false ? "raccolta errori disabilitata adesso" : "configurazione N/D") +
+        (Note.Length == 0 ? "" : " · " + Note);
+}
+public sealed record NativeNetworkEvent(DateTime Utc, long? RecordId, int EventId, string Event,
+    string SourceAddress, string SourcePort, string DestinationAddress, string DestinationPort,
+    string Direction, string Protocol, int? Pid, string Application, string Status)
+{
+    public string Time => Utc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.CurrentCulture);
+    public string PidText => Pid?.ToString(CultureInfo.CurrentCulture) ?? "N/D";
+    public string Details => $"[Security:{RecordId?.ToString(CultureInfo.InvariantCulture) ?? "N/D"}] Evento {EventId}\n" +
+        $"Ora UTC: {Utc:O}\n{Event}\nSorgente: {SourceAddress} · porta {SourcePort}\n" +
+        $"Destinazione: {DestinationAddress} · porta {DestinationPort}\nDirezione: {Direction} · protocollo: {Protocol}\n" +
+        $"PID riportato all'epoca: {PidText} · programma riportato: {Application}\nStato riportato: {Status}\n" +
+        "È un evento storico del PC. Il PID può essere stato riutilizzato; non identifica l'istanza attuale. " +
+        "Un blocco o un accesso fallito non dimostra un'intrusione o un ascolto del traffico.";
+}
+public sealed record NativeNetworkSnapshot(DateTime CapturedUtc, DateTime SinceUtc, bool Available,
+    bool Partial, IReadOnlyList<NetworkAuditSetting> Audit, IReadOnlyList<NativeNetworkEvent> Events, string Note);
+public interface INativeNetworkEvidenceSource
+{
+    NativeNetworkSnapshot Capture(CancellationToken cancellationToken);
+}
+public static class NativeNetworkEvidence
+{
+    public const int MaximumEvents = 256, MaximumXmlChars = 32768, MaximumTotalXmlChars = 1048576;
+    public static readonly TimeSpan Window = TimeSpan.FromMinutes(15);
+    private static readonly XNamespace Ns = "http://schemas.microsoft.com/win/2004/08/events/event";
+    public static NativeNetworkEvent? Decode(string xml, DateTime sinceUtc, DateTime untilUtc)
+    {
+        if (xml.Length == 0 || xml.Length > MaximumXmlChars) throw new InvalidDataException("XML evento oltre il limite o vuoto.");
+        using var text = new StringReader(xml);
+        using var reader = XmlReader.Create(text, new XmlReaderSettings {
+            DtdProcessing = DtdProcessing.Prohibit, XmlResolver = null, MaxCharactersInDocument = MaximumXmlChars });
+        var root = XDocument.Load(reader).Root;
+        if (root?.Name != Ns + "Event") throw new InvalidDataException("Schema evento non riconosciuto.");
+        var system = root.Element(Ns + "System") ?? throw new InvalidDataException("Intestazione evento assente.");
+        if ((string?)system.Element(Ns + "Provider")?.Attribute("Name") != "Microsoft-Windows-Security-Auditing")
+            throw new InvalidDataException("Provider evento inatteso.");
+        if (!int.TryParse((string?)system.Element(Ns + "EventID"), NumberStyles.None, CultureInfo.InvariantCulture, out int id))
+            throw new InvalidDataException("ID evento non valido.");
+        if (id is not (5157 or 4625)) return null;
+        string stamp = (string?)system.Element(Ns + "TimeCreated")?.Attribute("SystemTime") ?? "";
+        if (!stamp.EndsWith('Z') || !DateTimeOffset.TryParse(stamp, CultureInfo.InvariantCulture, DateTimeStyles.None, out var time))
+            throw new InvalidDataException("Ora evento UTC non valida.");
+        if (time.UtcDateTime < sinceUtc || time.UtcDateTime > untilUtc) return null;
+        var fields = new Dictionary<string, string>(StringComparer.Ordinal);
+        foreach (var e in root.Element(Ns + "EventData")?.Elements(Ns + "Data") ?? [])
+        {
+            string name = (string?)e.Attribute("Name") ?? "";
+            if (name.Length == 0 || !fields.TryAdd(name, e.Value)) throw new InvalidDataException("Campi evento ambigui.");
+        }
+        string Get(string key) => fields.TryGetValue(key, out string? value) ? value : "";
+        string logon = Get("LogonType");
+        if (id == 4625 && logon is not ("3" or "10")) return null; // Network / RemoteInteractive only.
+        long? record = long.TryParse((string?)system.Element(Ns + "EventRecordID"), NumberStyles.None,
+            CultureInfo.InvariantCulture, out long recordId) && recordId > 0 ? recordId : null;
+        string source = Address(Get(id == 5157 ? "SourceAddress" : "IpAddress"));
+        string direction = id == 4625 ? "Accesso alla macchina" : Get("Direction") switch {
+            "%%14592" => "Ingresso", "%%14593" => "Uscita", _ => "N/D" };
+        string protocol = id == 4625 ? "N/D" : Get("Protocol") switch { "6" => "TCP", "17" => "UDP", "1" => "ICMP", "58" => "ICMPv6", _ => Clean(Get("Protocol"), 16) };
+        return new(time.UtcDateTime, record, id,
+            id == 5157 ? "Connessione bloccata da WFP" : logon == "10" ? "Accesso interattivo remoto fallito" : "Accesso di rete fallito",
+            source, Port(Get(id == 5157 ? "SourcePort" : "IpPort")),
+            id == 5157 ? Address(Get("DestAddress")) : "Questo PC", id == 5157 ? Port(Get("DestPort")) : "N/D",
+            direction, protocol, Pid(Get(id == 5157 ? "ProcessID" : "ProcessId")),
+            Basename(Get(id == 5157 ? "Application" : "ProcessName")), id == 4625 ? Clean(Get("Status"), 32) : "Blocco registrato");
+    }
+    private static string Address(string value) => IPAddress.TryParse(value, out var ip) ? ip.ToString() : "N/D";
+    private static string Port(string value) => ushort.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out var port)
+        ? port.ToString(CultureInfo.InvariantCulture) : "N/D";
+    private static int? Pid(string value)
+    {
+        bool hex = value.StartsWith("0x", StringComparison.OrdinalIgnoreCase);
+        return int.TryParse(hex ? value[2..] : value, hex ? NumberStyles.AllowHexSpecifier : NumberStyles.None,
+            CultureInfo.InvariantCulture, out int pid) && pid >= 0 ? pid : null;
+    }
+    private static string Basename(string value) => Clean(value.Replace('/', '\\').Split('\\').LastOrDefault() ?? "", 128);
+    private static string Clean(string value, int cap)
+    {
+        if (string.IsNullOrWhiteSpace(value) || value == "-") return "N/D";
+        return new string(value.Take(cap).Select(c => char.IsControl(c) || char.GetUnicodeCategory(c) == UnicodeCategory.Format ? ' ' : c).ToArray());
+    }
+    public static string Report(NativeNetworkSnapshot s) =>
+        $"[Security] Campione: {s.CapturedUtc:O}\nIntervallo UTC: {s.SinceUtc:O} → {s.CapturedUtc:O}\n" +
+        (s.Available ? $"Eventi nel campione: {s.Events.Count} · blocchi WFP: {s.Events.Count(e => e.EventId == 5157)} · accessi di rete/remoti falliti: {s.Events.Count(e => e.EventId == 4625)}" : "Registro Security: non disponibile; conteggi N/D") +
+        (s.Partial ? "\nLettura parziale: non rappresenta tutti gli eventi dell'intervallo." : "") + "\n" +
+        string.Join("\n", s.Audit.Select(a => a.Text)) + "\n" + s.Note + "\n" +
+        "La configurazione attuale non ricostruisce quella passata o le eccezioni per utente. Zero eventi non certifica assenza di tentativi. " +
+        "Questa vista non conta i client del router e non rileva con certezza un ascolto passivo.\n" +
+        string.Join("\n\n", s.Events.Select(e => e.Details));
+}
diff --git a/src/ProcessLens.Windows/WindowsNativeNetworkEvidence.cs b/src/ProcessLens.Windows/WindowsNativeNetworkEvidence.cs
new file mode 100644
index 0000000..7e9b824
--- /dev/null
+++ b/src/ProcessLens.Windows/WindowsNativeNetworkEvidence.cs
@@ -0,0 +1,161 @@
+using System.ComponentModel;
+using System.Diagnostics;
+using System.Runtime.InteropServices;
+using System.Xml;
+using ProcessLens.Core;
+
+namespace ProcessLens.Windows;
+
+internal interface INetworkEvidenceApi
+{
+    NetworkAuditSetting ReadAudit(Guid category, string name);
+    IntPtr Query(string xpath);
+    bool Next(IntPtr query, out IntPtr record, out int error);
+    string Render(IntPtr record);
+    void Close(IntPtr handle);
+}
+
+// Local, read-only manual history. No WFP filter, audit-policy change, driver or subscription.
+public sealed class WindowsNativeNetworkEvidence : INativeNetworkEvidenceSource
+{
+    internal static readonly Guid ConnectionAudit = new("0cce9226-69ae-11d9-bed3-505054503030");
+    internal static readonly Guid LogonAudit = new("0cce9215-69ae-11d9-bed3-505054503030");
+    internal static string QueryText(DateTime since, DateTime until) =>
+        "*[System[Provider[@Name='Microsoft-Windows-Security-Auditing'] and (EventID=5157 or EventID=4625) and " +
+        $"TimeCreated[@SystemTime >= '{since:O}' and @SystemTime <= '{until:O}']]]";
+    private readonly INetworkEvidenceApi _api;
+    public WindowsNativeNetworkEvidence() : this(new NetworkEvidenceApi()) { }
+    internal WindowsNativeNetworkEvidence(INetworkEvidenceApi api) { _api = api; }
+    public NativeNetworkSnapshot Capture(CancellationToken cancellationToken)
+    {
+        DateTime until = DateTime.UtcNow, since = until - NativeNetworkEvidence.Window;
+        var audit = new List<NetworkAuditSetting>();
+        var rows = new List<NativeNetworkEvent>();
+        var seen = new HashSet<long>();
+        bool available = false, partial = false;
+        string note = "Fonte: Windows Event Log API · Security locale · eventi 5157 e 4625 tipi 3/10. " +
+            "Massimo 256 eventi letti; nessuna modifica ai criteri di audit o al firewall.";
+        IntPtr query = IntPtr.Zero;
+        try
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            audit.Add(_api.ReadAudit(ConnectionAudit, "Blocchi connessione / WFP"));
+            cancellationToken.ThrowIfCancellationRequested();
+            audit.Add(_api.ReadAudit(LogonAudit, "Accessi / Logon"));
+            query = _api.Query(QueryText(since, until));
+            if (query == IntPtr.Zero) throw new InvalidDataException("Handle della query eventi non valido.");
+            var watch = Stopwatch.StartNew();
+            int chars = 0, scanned = 0, malformed = 0;
+            bool exhausted = false;
+            for (; scanned < NativeNetworkEvidence.MaximumEvents && watch.Elapsed < TimeSpan.FromSeconds(3); scanned++)
+            {
+                cancellationToken.ThrowIfCancellationRequested();
+                if (!_api.Next(query, out IntPtr record, out int error))
+                {
+                    if (record != IntPtr.Zero) _api.Close(record);
+                    if (error == 259) { available = true; exhausted = true; break; } // ERROR_NO_MORE_ITEMS only.
+                    throw new Win32Exception(error, "EvtNext non riuscita · Win32 " + error);
+                }
+                available = true;
+                try
+                {
+                    if (record == IntPtr.Zero) throw new InvalidDataException("Handle evento nullo.");
+                    string xml = _api.Render(record);
+                    if (xml.Length > NativeNetworkEvidence.MaximumTotalXmlChars - chars)
+                    { partial = true; note += " Limite testo raggiunto."; break; }
+                    chars += xml.Length;
+                    try
+                    {
+                        var item = NativeNetworkEvidence.Decode(xml, since, until);
+                        if (item is not null && (!item.RecordId.HasValue || seen.Add(item.RecordId.Value))) rows.Add(item);
+                    }
+                    catch (Exception ex) when (ex is XmlException or InvalidDataException)
+                    { malformed++; partial = true; }
+                }
+                finally { if (record != IntPtr.Zero) _api.Close(record); }
+            }
+            if (!exhausted) { partial = true; note += " Lettura limitata per numero, tempo o testo."; }
+            if (malformed > 0) note += $" {malformed} eventi non interpretabili.";
+        }
+        catch (OperationCanceledException) { throw; }
+        catch (Exception ex) when (ex is Win32Exception or InvalidDataException or DllNotFoundException or EntryPointNotFoundException)
+        {
+            partial = true;
+            note += " " + (ex is Win32Exception native ? "Win32 " + native.NativeErrorCode + " · " : "") + ex.Message + (ex is Win32Exception { NativeErrorCode: 5 } ? " Lettura non autorizzata: può richiedere privilegi amministrativi o diritti sul registro Security." : "");
+        }
+        finally { if (query != IntPtr.Zero) _api.Close(query); }
+        return new(until, since, available, partial, audit, rows, note);
+    }
+}
+
+internal sealed class NetworkEvidenceApi : INetworkEvidenceApi
+{
+    [StructLayout(LayoutKind.Sequential)]
+    internal struct AuditPolicyInfo { public Guid Subcategory; public uint Flags; public Guid Category; }
+    [DllImport("advapi32.dll", ExactSpelling = true, SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.U1)]
+    private static extern bool AuditQuerySystemPolicy(ref Guid subcategory, uint count, out IntPtr policy);
+    [DllImport("advapi32.dll", ExactSpelling = true)] private static extern void AuditFree(IntPtr buffer);
+    [DllImport("wevtapi.dll", CharSet = CharSet.Unicode, ExactSpelling = true, SetLastError = true)]
+    private static extern IntPtr EvtQuery(IntPtr session, string path, string query, uint flags);
+    [DllImport("wevtapi.dll", ExactSpelling = true, SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static extern bool EvtNext(IntPtr query, uint size, [Out] IntPtr[] events, uint timeout, uint flags, out uint returned);
+    [DllImport("wevtapi.dll", ExactSpelling = true, SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static extern bool EvtRender(IntPtr context, IntPtr record, uint flags, uint bytes,
+        IntPtr buffer, out uint used, out uint properties);
+    [DllImport("wevtapi.dll", ExactSpelling = true, SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)] private static extern bool EvtClose(IntPtr handle);
+    public NetworkAuditSetting ReadAudit(Guid category, string name)
+    {
+        IntPtr policy = IntPtr.Zero;
+        try
+        {
+            if (!AuditQuerySystemPolicy(ref category, 1, out policy))
+                return new(name, null, "AuditQuerySystemPolicy · Win32 " + Marshal.GetLastWin32Error());
+            if (policy == IntPtr.Zero) return new(name, null, "Risultato audit vuoto");
+            var info = Marshal.PtrToStructure<AuditPolicyInfo>(policy);
+            if (info.Subcategory != category) return new(name, null, "Sottocategoria audit inattesa");
+            return new(name, FailureEnabled(info.Flags), "Criterio di sistema attuale; eccezioni per utente non lette");
+        }
+        catch (Exception ex) when (ex is DllNotFoundException or EntryPointNotFoundException)
+        { return new(name, null, ex.Message); }
+        finally { if (policy != IntPtr.Zero) AuditFree(policy); }
+    }
+    internal static bool? FailureEnabled(uint flags) => (flags & ~7u) != 0 || (flags & 4u) != 0 && (flags & 3u) != 0
+        ? null : (flags & 2u) != 0;
+    public IntPtr Query(string xpath)
+    {
+        IntPtr query = EvtQuery(IntPtr.Zero, "Security", xpath, 0x201); // Channel path + reverse direction.
+        if (query == IntPtr.Zero) throw new Win32Exception(Marshal.GetLastWin32Error());
+        return query;
+    }
+    public bool Next(IntPtr query, out IntPtr record, out int error)
+    {
+        var events = new IntPtr[1];
+        bool ok = EvtNext(query, 1, events, 250, 0, out uint count);
+        error = ok ? 0 : Marshal.GetLastWin32Error(); record = events[0];
+        if (ok && (count != 1 || record == IntPtr.Zero))
+        { if (record != IntPtr.Zero) EvtClose(record); record = IntPtr.Zero; throw new InvalidDataException("Conteggio EvtNext inatteso."); }
+        return ok;
+    }
+    public string Render(IntPtr record)
+    {
+        bool first = EvtRender(IntPtr.Zero, record, 1, 0, IntPtr.Zero, out uint needed, out _);
+        int error = first ? 0 : Marshal.GetLastWin32Error();
+        if (first || error != 122 || needed < 2 || needed > NativeNetworkEvidence.MaximumXmlChars * 2u || (needed & 1) != 0)
+            throw new InvalidDataException("Dimensione XML evento non valida o EvtRender non disponibile · Win32 " + error);
+        IntPtr buffer = Marshal.AllocHGlobal(checked((int)needed));
+        try
+        {
+            if (!EvtRender(IntPtr.Zero, record, 1, needed, buffer, out uint used, out _))
+                throw new Win32Exception(Marshal.GetLastWin32Error());
+            if (used < 2 || used > needed || (used & 1) != 0 || Marshal.ReadInt16(buffer, (int)used - 2) != 0)
+                throw new InvalidDataException("XML evento troncato.");
+            return Marshal.PtrToStringUni(buffer, checked((int)used / 2 - 1)) ?? "";
+        }
+        finally { Marshal.FreeHGlobal(buffer); }
+    }
+    public void Close(IntPtr handle) { if (handle != IntPtr.Zero) EvtClose(handle); }
+}
