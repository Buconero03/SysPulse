+using System.Windows;
+using System.Windows.Controls;
+using System.Windows.Media;
+using System.IO;
+using ProcessLens.Core;
+using ProcessLens.Windows;
+
+namespace ProcessLens.App;
+
+public partial class NetworkDevicesView : UserControl
+{
+    private readonly INetworkDeviceSource _source;
+    private readonly DeviceRecognitionStore _store;
+    private readonly NetworkDeviceTracker _tracker = new();
+    private RecognitionCatalog _catalog = new(Array.Empty<DeviceRecognition>(), "");
+    private NetworkDeviceSnapshot? _snapshot;
+    private NetworkDeviceView? _view;
+    private bool _active, _busy, _current;
+    private int _generation;
+    public NetworkDevicesView() : this(new WindowsNetworkDevices(), new DeviceRecognitionStore(Path.Combine(
+        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "ProcessLens", "network-devices.json"))) { }
+    internal NetworkDevicesView(INetworkDeviceSource source, DeviceRecognitionStore store)
+    {
+        _source = source; _store = store;
+        InitializeComponent(); // No capture, file read or timer during construction.
+        UpdateButtons();
+    }
+
+    public void SetActive(bool active)
+    {
+        if (_active == active) return;
+        _active = active;
+        if (!active)
+        {
+            _generation++;
+            _current = false;
+            _snapshot = null; _view = null;
+            _catalog = new(Array.Empty<DeviceRecognition>(), "");
+            NetworkDevicesTable.ItemsSource = null;
+            NetworkIndicatorText.Text = "Elenco da aggiornare";
+            NetworkIndicatorBorder.BorderBrush = Brushes.SlateGray;
+            NetworkSummaryText.Text = "Premi Aggiorna elenco.";
+            NetworkUpdatedText.Text = "Elenco non aggiornato";
+            NetworkNoticeText.Text = "";
+            NetworkDetailsText.Text = "Le righe sono state rilasciate dopo la chiusura della sezione.";
+            if (_busy) ShowProblem("Sezione chiusa durante l’operazione. Premi Aggiorna elenco alla riapertura.");
+        }
+        UpdateButtons();
+    }
+
+    private async void RefreshNetwork_Click(object sender, RoutedEventArgs e) => await RefreshAsync();
+    internal async Task RefreshAsync()
+    {
+        if (!_active || _busy) return;
+        _busy = true; int generation = ++_generation;
+        _current = false;
+        UpdateButtons();
+        NetworkIndicatorText.Text = "Aggiornamento in corso…";
+        NetworkIndicatorBorder.BorderBrush = Brushes.SlateGray;
+        NetworkNoticeText.Text = "";
+        try
+        {
+            var result = await Task.Run(() => (Snapshot: _source.Capture(), Catalog: _store.Load()));
+            if (!_active || generation != _generation) return;
+            _snapshot = result.Snapshot; _catalog = result.Catalog;
+            _current = _snapshot.Available && !_snapshot.Partial && _snapshot.Neighbors.Count <= 4096;
+            Render();
+            int added = _tracker.Observe(_snapshot, _view!);
+            if (added > 0) NetworkNoticeText.Text = added == 1 ? "Nuovo dispositivo rilevato sulla rete." : $"{added} nuovi dispositivi rilevati sulla rete.";
+        }
+        catch (Exception ex) { if (_active && generation == _generation) ShowProblem("Controllo non riuscito: " + ex.Message); }
+        finally { _busy = false; UpdateButtons(); }
+    }
+
+    private void Render()
+    {
+        if (_snapshot is null) return;
+        string? selectedKey = (NetworkDevicesTable.SelectedItem as NetworkDeviceRow)?.Key;
+        _view = NetworkDeviceRules.Present(_snapshot, _catalog);
+        NetworkIndicatorText.Text = _view.Indicator;
+        NetworkIndicatorBorder.BorderBrush = (Brush)new BrushConverter().ConvertFromString(_view.Color)!;
+        NetworkSummaryText.Text = _view.Summary;
+        NetworkUpdatedText.Text = "Cache letta: " + _snapshot.CapturedUtc.ToLocalTime().ToString("g");
+        NetworkDetailsText.Text = "Schede Ethernet/Wi-Fi attive: " + _snapshot.Interfaces + "\n" + _view.Note +
+            "\nRiconoscimenti salvati solo su questo PC. Se il gateway non ha un MAC leggibile, il riconoscimento è disabilitato.";
+        NetworkDevicesTable.ItemsSource = _view.Rows;
+        NetworkDevicesTable.SelectedItem = _view.Rows.FirstOrDefault(r => r.Key == selectedKey);
+        UpdateButtons();
+    }
+
+    private void ShowProblem(string text)
+    {
+        _current = false;
+        NetworkIndicatorText.Text = "Controllo non disponibile";
+        NetworkIndicatorBorder.BorderBrush = Brushes.SlateGray;
+        NetworkNoticeText.Text = text;
+    }
+
+    private void NetworkSelection_Changed(object sender, SelectionChangedEventArgs e)
+    {
+        if (NetworkNameBox is null) return; // XAML can raise selection before all named elements exist.
+        var row = NetworkDevicesTable.SelectedItem as NetworkDeviceRow;
+        NetworkNameBox.Text = row?.Recognized == true ? row.Name : "";
+        NetworkSelectionText.Text = row is null ? "Seleziona un dispositivo per riconoscerlo." :
+            row.Mac + " · " + row.InterfaceName + (row.Gateway ? " · gateway configurato" : "") + "\n" + row.Presence;
+        UpdateButtons();
+    }
+    private void UpdateButtons()
+    {
+        if (RefreshNetworkButton is null || RecognizeNetworkButton is null) return;
+        var row = NetworkDevicesTable.SelectedItem as NetworkDeviceRow;
+        RefreshNetworkButton.IsEnabled = _active && !_busy;
+        CopyNetworkButton.IsEnabled = _active && !_busy && _view?.Rows.Count > 0;
+        RecognizeNetworkButton.IsEnabled = _active && !_busy && _current && row?.CanRecognize == true && _catalog.Available;
+        ForgetNetworkButton.IsEnabled = _active && !_busy && _current && row?.Recognized == true && _catalog.Available;
+        NetworkNameBox.IsEnabled = RecognizeNetworkButton.IsEnabled;
+    }
+    private async void RecognizeNetwork_Click(object sender, RoutedEventArgs e) => await SaveSelectionAsync(false);
+    private async void ForgetNetwork_Click(object sender, RoutedEventArgs e) => await SaveSelectionAsync(true);
+    internal async Task SaveSelectionAsync(bool forget)
+    {
+        if (!_active || _busy || !_current || !_catalog.Available || NetworkDevicesTable.SelectedItem is not NetworkDeviceRow { CanRecognize: true } row) return;
+        string name = NetworkNameBox.Text.Trim();
+        if (name.Length == 0) name = "Dispositivo riconosciuto";
+        var devices = _catalog.Devices.Where(d => NetworkDeviceRules.RecognitionKey(d.NetworkKey, d.Mac) !=
+            NetworkDeviceRules.RecognitionKey(row.NetworkKey, row.Mac)).ToList();
+        if (!forget) devices.Add(new(row.NetworkKey, row.Mac, name));
+        var updated = new RecognitionCatalog(devices, "");
+        _busy = true; int generation = _generation; UpdateButtons();
+        try
+        {
+            string error = await Task.Run(() => _store.Save(updated));
+            if (!_active || generation != _generation) return;
+            if (error.Length > 0) { ShowProblem(error); return; }
+            _catalog = updated; Render();
+            NetworkNoticeText.Text = forget ? "Riconoscimento rimosso." : "Riconoscimento salvato su questo PC.";
+        }
+        catch (Exception ex) { if (_active && generation == _generation) ShowProblem("Salvataggio non riuscito: " + ex.Message); }
+        finally { _busy = false; UpdateButtons(); }
+    }
+    private void CopyNetwork_Click(object sender, RoutedEventArgs e)
+    {
+        if (_view is null || _busy) return;
+        ClipboardText.Copy(this, "DISPOSITIVI SULLA RETE\n" + NetworkUpdatedText.Text + "\n" + _view.Summary +
+            "\n" + NetworkIndicatorText.Text + "\n" + NetworkNoticeText.Text + "\n\n" + GridCopySupport.CaptureTable(NetworkDevicesTable, false) +
+            "\n\nFonte: cache Windows IPv4/ARP e IPv6/ND. Elenco parziale; presenza e sicurezza della rete non certificate.\n" + _view.Note);
+    }
+}
