+    private string BuildRelatedMemoryEvidence(ProcessRow selectedRow, SystemMemoryEvidence? systemMemory)
+    {
+        var p = selectedRow.Process;
+        var related = _allRows
+            .Where(r => r.Name.Equals(p.Name, StringComparison.OrdinalIgnoreCase) ||
+                        (!string.IsNullOrWhiteSpace(selectedRow.OwnerApp) &&
+                         !selectedRow.OwnerApp.Equals("Windows", StringComparison.OrdinalIgnoreCase) &&
+                         r.OwnerApp.Equals(selectedRow.OwnerApp, StringComparison.OrdinalIgnoreCase)))
+            .ToArray();
+
+        if (related.Length <= 1)
+            return "■ IMPATTO COMPLESSIVO DELL'APPLICAZIONE (PROCESSO SINGOLO)\n" +
+                   $"Non risultano altri processi attivi associati a {selectedRow.FriendlyName} ({p.Name}): " +
+                   "l'intero consumo dell'applicazione coincide con quello di questo singolo PID.";
+
+        var withPrivateWs = related.Where(r => r.Process.PrivateWorkingSetAvailable).ToArray();
+        double totalPrivateMb = withPrivateWs.Sum(r => r.Process.PrivateWorkingSetMb);
+        double totalCommitMb = related.Where(r => r.Process.PrivateCommitAvailable).Sum(r => r.Process.PrivateMb);
+        double singleSharePct = totalPrivateMb > 0 && p.PrivateWorkingSetAvailable
+            ? Math.Clamp(100.0 * p.PrivateWorkingSetMb / totalPrivateMb, 0, 100)
+            : 0;
+        string sysPctText = systemMemory is { TotalBytes: > 0 } && totalPrivateMb > 0
+            ? $" ({100.0 * (totalPrivateMb * 1048576.0) / systemMemory.TotalBytes:F1}% della RAM fisica totale del PC)"
+            : "";
+
+        var topSiblings = related
+            .OrderByDescending(r => r.Process.PrivateWorkingSetAvailable ? r.Process.PrivateWorkingSetMb : r.Process.WorkingSetMb)
+            .Take(6)
+            .Select(r =>
+            {
+                string marker = r.Pid == p.Pid ? " [PID selezionato]" : "";
+                string mem = r.Process.PrivateWorkingSetAvailable
+                    ? $"{r.Process.PrivateWorkingSetMb:F1} MiB privati"
+                    : $"{r.Process.WorkingSetMb:F1} MiB tot.";
+                return $"• PID {r.Pid}{marker} ({r.Role}): {mem} — commit {(r.Process.PrivateCommitAvailable ? $"{r.Process.PrivateMb:F1} MiB" : "N/D")}";
+            });
+
+        return "■ IMPATTO COMPLESSIVO DELL'APPLICAZIONE (" + related.Length + " PROCESSI CORRELATI)\n" +
+               $"• Processi attivi del gruppo «{selectedRow.OwnerApp} / {p.Name}»: {related.Length} istanze.\n" +
+               $"• RAM privata residente sommata dell'intero gruppo: {totalPrivateMb:F1} MiB{sysPctText} " +
+               $"(somma esatta delle sole pagine private esclusive, senza duplicare le DLL condivise).\n" +
+               $"• Commit privato sommato dell'intero gruppo: {totalCommitMb:F1} MiB.\n" +
+               (singleSharePct > 0
+                   ? $"• Peso di questo singolo PID ({p.Pid}) sul totale dell'app: {singleSharePct:F0}%.\n"
+                   : "") +
+               "Principali processi del gruppo per consumo di RAM:\n" +
+               string.Join("\n", topSiblings);
     }
 
