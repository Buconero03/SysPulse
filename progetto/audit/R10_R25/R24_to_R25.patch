diff --git a/progetto/src/ProcessLens.Windows/OwnedNetworkTableReader.cs b/progetto/src/ProcessLens.Windows/OwnedNetworkTableReader.cs
new file mode 100644
index 0000000..2f6f667
--- /dev/null
+++ b/progetto/src/ProcessLens.Windows/OwnedNetworkTableReader.cs
@@ -0,0 +1,33 @@
+using System.ComponentModel;
+using System.Runtime.InteropServices;
+
+namespace ProcessLens.Windows;
+
+internal static class OwnedNetworkTableReader
+{
+    internal delegate uint Query(IntPtr buffer, ref int size);
+    internal static void Read(int rowSize, Query query, Action<IntPtr, int> consume)
+    {
+        const int maximum = 16 * 1024 * 1024;
+        int size = 0; uint result = query(IntPtr.Zero, ref size);
+        if (result != 0 && result != 122 && result != 234) throw new Win32Exception((int)result);
+        for (int attempt = 0; attempt < 3; attempt++)
+        {
+            if (size < 4 || size > maximum || rowSize <= 0) throw new InvalidDataException("Dimensione tabella rete non valida o oltre 16 MiB.");
+            int capacity = size; IntPtr buffer = Marshal.AllocHGlobal(capacity);
+            try
+            {
+                result = query(buffer, ref size);
+                if (result is 122 or 234) continue; // Connections changed between size query and read.
+                if (result != 0) throw new Win32Exception((int)result);
+                if (size < 4 || size > capacity) throw new InvalidDataException("Dimensione restituita dalla tabella rete non valida.");
+                int count = Marshal.ReadInt32(buffer);
+                if (count < 0 || count > 100000 || 4L + (long)count * rowSize > size)
+                    throw new InvalidDataException("Conteggio righe rete non valido o troncato.");
+                consume(IntPtr.Add(buffer, 4), count); return;
+            }
+            finally { Marshal.FreeHGlobal(buffer); }
+        }
+        throw new IOException("La tabella rete cambia durante la lettura: riprova l'aggiornamento.");
+    }
+}
