                                <l10n:LocalizedExpander Header="{l10n:Tr 9A4CB701C629661C}" IsExpanded="False" Margin="0,4,0,0">
                                    <local:SelectableText x:Name="DiagnosticOriginalText" Text="{Binding SelectedItem.OriginalMessage, ElementName=DiagnosticsTable, Mode=OneWay}"
                                                          FontFamily="Consolas" FontSize="12" Margin="0,8,0,0"/>
                                </l10n:LocalizedExpander>
                            </StackPanel>
                        </ScrollViewer>
                        <local:SelectableText Grid.Row="5" Text="{l10n:Tr 3D8D7C89F1D9DC5C}"
                                   Foreground="#64748B" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </l10n:LocalizedTabItem>
            </TabControl>
