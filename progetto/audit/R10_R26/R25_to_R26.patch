new file mode 100644
index 0000000..6fc1d4b
--- /dev/null
+++ b/progetto/src/ProcessLens.App/ReadingPositionPolicy.cs
@@ -0,0 +1,34 @@
+using System.Collections.ObjectModel;
+
+namespace ProcessLens.App;
+
+// One ticket per pending layout operation; no timers or retained history.
+internal sealed class ReadingPositionPolicy
+{
+    private long _revision;
+    public long Capture() => ++_revision;
+    public void UserInput() => ++_revision;
+    public bool IsCurrent(long ticket) => ticket == _revision;
+    public static bool HoldOrder(double offset, bool pointerWithin, bool keyboardWithin) =>
+        offset > 0.5 || pointerWithin || keyboardWithin;
+    public static void Synchronize<T>(ObservableCollection<T> target, IReadOnlyList<T> desired, bool holdOrder) where T : class
+    {
+        var wanted = desired.ToHashSet();
+        for (int i = target.Count - 1; i >= 0; i--) if (!wanted.Contains(target[i])) target.RemoveAt(i);
+        if (holdOrder)
+        {
+            var existing = target.ToHashSet();
+            foreach (var item in desired) if (existing.Add(item)) target.Add(item);
+            return;
+        }
+        for (int i = 0; i < desired.Count; i++)
+        {
+            if (i < target.Count && ReferenceEquals(target[i], desired[i])) continue;
+            int current = target.IndexOf(desired[i]);
+            if (current < 0) target.Insert(i, desired[i]);
+            else target.Move(current, i);
+        }
+    }
+    public static double AnchoredOffset(double currentOffset, double previousY, double currentY) =>
+        Math.Max(0, currentOffset + currentY - previousY);
+}
