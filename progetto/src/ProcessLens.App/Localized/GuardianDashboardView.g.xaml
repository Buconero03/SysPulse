                                <l10n:LocalizedTextBlock Text="{l10n:Tr 1DF500FF7D2346D1}" FontSize="11" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="ActivityTrendList">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,12,6">
                                                <DockPanel LastChildFill="True" Margin="0,0,0,3">
                                                    <l10n:LocalizedTextBlock Text="{Binding TimeLocal}" FontSize="10" Foreground="#64748B"/>
                                                    <l10n:LocalizedTextBlock Text="{Binding Starts}" HorizontalAlignment="Right" DockPanel.Dock="Right" FontSize="10" FontWeight="SemiBold"/>
                                                </DockPanel>
                                                <ProgressBar Value="{Binding PercentOfMax}" Maximum="100" Minimum="0"
                                                             Height="9" Foreground="#5386CF" Background="#E4EAF3" BorderThickness="0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <l10n:LocalizedTextBlock Text="{l10n:Tr 79340B48536899ED}"
                                           FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <l10n:LocalizedTextBlock Text="{l10n:Tr 9CC728A391AB34EC}" FontWeight="SemiBold" Margin="4,0,0,10" Foreground="#475569"/>
                            <DataGrid local:GridCopySupport.Enabled="True" x:Name="TopProcessesTable" Grid.Row="1" Style="{StaticResource GuardianTable}">
                                <DataGrid.Columns>
                                    <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 5086900635FEC3EF}" Binding="{Binding Name}" Width="*"/>
                                    <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 23AC54F2A9422E4E}" Binding="{Binding Starts}" Width="75"/>
                                    <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 48B82DE27DCD71AB}" Binding="{Binding StartsPerMinute}" Width="83"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <l10n:LocalizedTextBlock Text="{l10n:Tr 69EC26ADDE77001D}" FontWeight="SemiBold" Margin="4,0,0,10" Foreground="#475569"/>
                            <DataGrid local:GridCopySupport.Enabled="True" x:Name="ParentsTable" Grid.Row="1" Style="{StaticResource GuardianTable}" MouseDoubleClick="ParentsTable_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr D306E87B3E01542C}" Binding="{Binding ParentPid}" Width="83"/>
                                    <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 08B20916F65B5ACA}" Binding="{Binding CandidateParent}" Width="*"/>
                                    <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr B54BD55EFE78EAD7}" Binding="{Binding ChildName}" Width="*"/>
                                    <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 23AC54F2A9422E4E}" Binding="{Binding Starts}" Width="65"/>
                                    <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 4F44EB26FB07B2C9}" Binding="{Binding Evidence}" Width="1.65*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <local:SelectableText Grid.Row="2" Text="{l10n:Tr 0310E457BEB664B6}"
                                       Foreground="#64748B" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </Grid>
                </l10n:LocalizedTabItem>
                <l10n:LocalizedTabItem x:Name="LineageTab" Header="{l10n:Tr F9F4E9858E3E6E3C}">
                    <Grid Margin="8,12,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <l10n:LocalizedTextBlock Text="{l10n:Tr C8FA7AA685F99A33}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,9,0"/>
                            <l10n:LocalizedTextBox x:Name="LineagePidBox" Width="110" Height="30" VerticalContentAlignment="Center"
                                     Padding="7,3" Text="" Margin="0,0,8,0"/>
