                                <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 96714DE0E67015A8}" Binding="{Binding AverageCpu}" Width="130"/>
                                <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 8D9331CAB97347C9}" Binding="{Binding PeakCpu}" Width="130"/>
                                <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 1256938BEA6F4746}" Binding="{Binding PeakResidentMiB}" Width="185"/>
                                <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 86F1F774809441D4}" Binding="{Binding Samples}" Width="115"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <local:SelectableText Grid.Row="2" Text="{l10n:Tr ED98EDC07E79B1B1}"
                                   Foreground="#64748B" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </l10n:LocalizedTabItem>
                <l10n:LocalizedTabItem Header="{l10n:Tr 7F423FA440A3217D}">
