@@ -0,0 +1,32 @@
+namespace ProcessLens.Core;
+
+public sealed record NewTaskRequest(string Program, string Arguments, string WorkingDirectory)
+{
+    // Fields remain separate: no shell is added and arguments are not re-tokenized or expanded.
+    public static bool TryCreate(string program, string arguments, string directory,
+        out NewTaskRequest? request, out string error, bool expandEnvironment = true)
+    {
+        request = null; error = "";
+        program = program.Trim(); directory = directory.Trim();
+        if (expandEnvironment)
+        { program = Environment.ExpandEnvironmentVariables(program); directory = Environment.ExpandEnvironmentVariables(directory); }
+        if (program.Length >= 2 && program[0] == '"' && program[^1] == '"') program = program[1..^1];
+        if (directory.Length >= 2 && directory[0] == '"' && directory[^1] == '"') directory = directory[1..^1];
+        if (string.IsNullOrWhiteSpace(program)) { error = "Inserisci il programma da avviare."; return false; }
+        if (program.Any(char.IsControl) || program.Contains('"') || directory.Any(char.IsControl) || directory.Contains('"') ||
+            arguments.Any(c => char.IsControl(c) && c != '\t'))
+        { error = "I campi contengono caratteri non validi o interruzioni di riga."; return false; }
+        string name = program.Replace('\\', '/').Split('/')[^1];
+        string extension = System.IO.Path.GetExtension(name);
+        if (program.Contains("://", StringComparison.Ordinal) || name.Length == 0 ||
+            (extension.Length > 0 && !extension.Equals(".exe", StringComparison.OrdinalIgnoreCase) &&
+                !extension.Equals(".com", StringComparison.OrdinalIgnoreCase)))
+        { error = "Scegli un eseguibile (.exe o .com). Per uno script usa il relativo interprete e il campo Argomenti."; return false; }
+        if ((long)program.Length + arguments.Length + 4 > 32767 || directory.Length > 32760)
+        { error = "Programma, argomenti o cartella oltre il limite di lunghezza."; return false; }
+        request = new(program, arguments, directory); return true;
+    }
+}
+
+public sealed record NewTaskResult(bool Started, int? Pid, string Message);
+public interface INewTaskLauncher { NewTaskResult Start(NewTaskRequest request); }
diff --git a/progetto/src/ProcessLens.Windows/WindowsNewTaskLauncher.cs b/progetto/src/ProcessLens.Windows/WindowsNewTaskLauncher.cs
new file mode 100644
index 0000000..cd02599
--- /dev/null
+++ b/progetto/src/ProcessLens.Windows/WindowsNewTaskLauncher.cs
@@ -0,0 +1,46 @@
+using System.ComponentModel;
+using System.Diagnostics;
+using ProcessLens.Core;
+
+namespace ProcessLens.Windows;
+
+// Invoked only by the explicit Run action. No command history, shell wrapper, monitoring or child termination.
+public sealed class WindowsNewTaskLauncher : INewTaskLauncher
+{
+    internal static ProcessStartInfo CreateStartInfo(NewTaskRequest request) => new()
+    {
+        FileName = request.Program, Arguments = request.Arguments, WorkingDirectory = request.WorkingDirectory,
+        UseShellExecute = false, ErrorDialog = false, CreateNoWindow = false
+    };
+    public NewTaskResult Start(NewTaskRequest request)
+    {
+        // Revalidate public inputs; do not rely on the UI being the sole caller.
+        if (!NewTaskRequest.TryCreate(request.Program, request.Arguments, request.WorkingDirectory, out var validated, out string error, expandEnvironment: false))
+            return new(false, null, error);
+        if (validated!.WorkingDirectory.Length > 0 && !Directory.Exists(validated.WorkingDirectory))
+            return new(false, null, "Cartella iniziale non trovata o non accessibile.");
+        try
+        {
+            using var process = Process.Start(CreateStartInfo(validated));
+            return process is null ? new(false, null, "Avvio non confermato da Windows.")
+                : new(true, process.Id, $"Attività avviata · PID {process.Id}.");
+        }
+        catch (Exception ex) when (ex is Win32Exception or InvalidOperationException or ArgumentException or IOException or UnauthorizedAccessException)
+        { return Failure(ex); }
+    }
+    public static NewTaskResult Failure(Exception error)
+    {
+        // Raw exception messages can contain the command line: retain the error code, not those arguments.
+        int? code = (error as Win32Exception)?.NativeErrorCode;
+        string message = code switch {
+            2 or 3 => "Programma o percorso non trovato.",
+            5 => "Accesso negato al programma.",
+            193 or 216 => "Formato del programma non compatibile con Windows o con questa architettura.",
+            740 => "Il programma richiede privilegi di amministratore.",
+            1223 => "Avvio annullato.",
+            _ => "Impossibile avviare il programma. Controlla programma, argomenti e cartella iniziale."
+        };
+        if (code.HasValue) message += $" Codice Windows: {code.Value}.";
+        return new(false, null, message);
+    }
+}
