+    private async Task InspectPidMemoryFromDashboardAsync(int pid)
+    {
+        if (_allRows.FirstOrDefault(r => r.Pid == pid) is null)
+            await RefreshAsync();
+        var target = _allRows.FirstOrDefault(r => r.Pid == pid);
+        if (target is null) return;
+        _activeFilter = "Tutti";
+        _selectedPid = pid;
+        SetFilterButtonState();
+        SetWorkspaceMode("processes");
+        ApplyFilter(pid);
+        if (ProcessList.SelectedItem is not null)
+            ProcessList.ScrollIntoView(ProcessList.SelectedItem);
+        await AskSelectedProcessAsync("Perché consuma così tanta RAM o memoria?");
+        ProcessQueryAnswerCard.BringIntoView();
+    }
