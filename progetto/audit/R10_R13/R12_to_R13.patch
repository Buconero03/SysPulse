+using System.Diagnostics;
+using System.IO;
+using System.Windows;
+using System.Windows.Controls;
+using Microsoft.Win32;
+using ProcessLens.Core;
+using ProcessLens.Windows;
+
+namespace ProcessLens.App;
+
+public partial class NetworkCaptureView : UserControl
+{
+    private readonly IPacketCaptureClient _client;
+    private CaptureTools? _tools;
+    private string? _selectedDumpcap, _lastFile;
+    private string? _capturedFile;
+    private string _captureDetail = "";
+    private PacketEvidence? _evidence;
+    private CancellationTokenSource? _operation;
+    private bool _active, _busy, _monitorVerified, _fileReady;
+    private int _generation;
+    public NetworkCaptureView() : this(new WiresharkTools()) { }
+    internal NetworkCaptureView(IPacketCaptureClient client) { _client = client; InitializeComponent(); UpdateButtons(); }
+    public void SetActive(bool active)
+    {
+        _active = active;
+        if (!active)
+        {
+            _generation++; _operation?.Cancel(); _monitorVerified = false; _evidence = null;
+            CaptureObservationsTable.ItemsSource = null;
+            CaptureSummaryText.Text = "Campione rilasciato. Le operazioni in corso vengono interrotte.";
+            CaptureStatusText.Text = "Vista sospesa. Nessuna cattura automatica alla riapertura.";
+        }
+        UpdateButtons();
+    }
+    private async Task ExecuteAsync<T>(Func<CancellationToken, Task<T>> operation, Action<T> publish, string progress)
+    {
+        if (!_active || _busy) return;
+        _busy = true; int generation = ++_generation;
+        using var cancel = new CancellationTokenSource(); _operation = cancel;
+        CaptureStatusText.Text = progress; UpdateButtons();
+        try
+        {
+            T result = await operation(cancel.Token);
+            if (_active && generation == _generation && !cancel.IsCancellationRequested) publish(result);
+            else if (_active && generation == _generation) CaptureStatusText.Text = "Operazione interrotta; eventuale file salvato può essere parziale.";
+        }
+        catch (OperationCanceledException) { if (_active && generation == _generation) CaptureStatusText.Text = "Operazione interrotta."; }
+        catch (Exception ex)
+        {
+            if (_active && generation == _generation)
+            { CaptureStatusText.Text = "Operazione non riuscita: " + ex.Message; if (_evidence is null) CaptureSummaryText.Text = "Risultato: N/D."; }
+        }
+        finally { _operation = null; _busy = false; UpdateButtons(); }
+    }
+    internal Task DiscoverAsync()
+    {
+        if (!_active || _busy) return Task.CompletedTask;
+        _tools = null; _monitorVerified = false; CaptureInterfacesBox.ItemsSource = null;
+        return ExecuteAsync(token => _client.DiscoverAsync(_selectedDumpcap, token), result =>
+        {
+            _tools = result.Tools; _monitorVerified = false;
+            CaptureInterfacesBox.ItemsSource = result.Interfaces; CaptureInterfacesBox.SelectedIndex = -1;
+            CaptureStatusText.Text = result.Detail;
+            CaptureDetailsText.Text = _tools is null ? result.Detail : _tools.Dumpcap + "\n" + _tools.Tshark + "\n" + result.Detail;
+        }, "Verifica strumenti e interfacce in corso…");
+    }
+    private async void Discover_Click(object sender, RoutedEventArgs e) => await DiscoverAsync();
+    private async void ChooseTools_Click(object sender, RoutedEventArgs e)
+    {
+        var dialog = new OpenFileDialog { Title = "Scegli dumpcap.exe della tua installazione Wireshark", Filter = "Wireshark dumpcap|dumpcap.exe", CheckFileExists = true };
+        if (dialog.ShowDialog() == true) { _selectedDumpcap = dialog.FileName; _tools = null; _monitorVerified = false; await DiscoverAsync(); }
+    }
+    private void Interface_Changed(object sender, SelectionChangedEventArgs e) { _monitorVerified = false; UpdateButtons(); }
+    private void Monitor_Changed(object sender, RoutedEventArgs e) { _monitorVerified = false; UpdateButtons(); }
+    internal Task VerifyMonitorAsync()
+    {
+        if (_tools is null || CaptureInterfacesBox.SelectedItem is not CaptureInterface adapter || CaptureMonitorBox.IsChecked != true) return Task.CompletedTask;
+        if (!_active || _busy) return Task.CompletedTask;
+        _monitorVerified = false;
+        return ExecuteAsync(token => _client.CheckMonitorAsync(_tools, adapter, token), result =>
+        { _monitorVerified = result.Supported; CaptureStatusText.Text = result.Detail; }, "Verifica monitor: la scheda può disconnettersi dal Wi-Fi…");
+    }
+    private async void Monitor_Click(object sender, RoutedEventArgs e) => await VerifyMonitorAsync();
+    internal Task CaptureAsync(string path)
+    {
+        if (!_active || _busy || _tools is null || CaptureInterfacesBox.SelectedItem is not CaptureInterface adapter ||
+            (CaptureMonitorBox.IsChecked == true && !_monitorVerified)) return Task.CompletedTask;
+        bool monitor = CaptureMonitorBox.IsChecked == true;
+        _evidence = null; CaptureObservationsTable.ItemsSource = null; CaptureSummaryText.Text = "Nessun campione analizzato per questa cattura.";
+        _fileReady = false;
+        _lastFile = path; CaptureFileText.Text = "File scelto: " + path;
+        return ExecuteAsync(token => _client.CaptureAsync(_tools, adapter, monitor, path, token), result =>
+        { _lastFile = _capturedFile = result.Path; _captureDetail = result.Detail; _fileReady = result.Complete; CaptureFileText.Text = result.Path; CaptureStatusText.Text = result.Detail; }, "Cattura in corso · massimo 20 secondi…");
+    }
+    private async void Capture_Click(object sender, RoutedEventArgs e)
+    {
+        var dialog = new SaveFileDialog { Title = "Salva in un nuovo file locale .pcapng", Filter = "Cattura pcapng|*.pcapng", FileName = "ProcessLens-" + DateTime.Now.ToString("yyyyMMdd-HHmmss") + ".pcapng", AddExtension = true, DefaultExt = ".pcapng" };
+        if (dialog.ShowDialog() == true) await CaptureAsync(dialog.FileName);
+    }
+    internal Task AnalyzeAsync(string path)
+    {
+        if (!_active || _busy || _tools is null) return Task.CompletedTask;
+        _evidence = null; CaptureObservationsTable.ItemsSource = null; CaptureSummaryText.Text = "Analisi in corso…";
+        _fileReady = false;
+        _lastFile = path; CaptureFileText.Text = "File selezionato: " + path;
+        return ExecuteAsync(token => _client.AnalyzeAsync(_tools, path, token), result =>
+        {
+            _fileReady = true;
+            _evidence = result with { Note = result.Note + (string.Equals(path, _capturedFile, StringComparison.OrdinalIgnoreCase) ? "\nEsito della cattura:\n" + _captureDetail : "") };
+            CaptureObservationsTable.ItemsSource = result.Rows;
+            CaptureSummaryText.Text = $"{result.Packets} pacchetti esaminati · {result.WifiFrames} frame 802.11" + (result.Limited ? " · campione limitato" : "");
+            CaptureStatusText.Text = "Analisi del file completata."; CaptureDetailsText.Text = _evidence.Note;
+        }, "Analisi locale con TShark in corso…");
+    }
+    private async void Read_Click(object sender, RoutedEventArgs e) { if (_lastFile is not null) await AnalyzeAsync(_lastFile); }
+    private async void Import_Click(object sender, RoutedEventArgs e)
+    {
+        var dialog = new OpenFileDialog { Title = "Analizza una cattura locale · massimo 12 MiB", Filter = "Catture|*.pcapng;*.pcap", CheckFileExists = true };
+        if (dialog.ShowDialog() == true) await AnalyzeAsync(dialog.FileName);
+    }
+    private void Stop_Click(object sender, RoutedEventArgs e) => _operation?.Cancel();
+    private void UpdateButtons()
+    {
+        if (CopyCaptureButton is null) return;
+        bool ready = _active && !_busy, selected = CaptureInterfacesBox.SelectedItem is CaptureInterface;
+        DiscoverCaptureButton.IsEnabled = ChooseToolsButton.IsEnabled = ready;
+        CaptureInterfacesBox.IsEnabled = CaptureMonitorBox.IsEnabled = ready;
+        VerifyMonitorButton.IsEnabled = ready && _tools is not null && selected && CaptureMonitorBox.IsChecked == true;
+        StartCaptureButton.IsEnabled = ready && _tools is not null && selected && (CaptureMonitorBox.IsChecked != true || _monitorVerified);
+        StopCaptureButton.IsEnabled = _active && _busy;
+        ImportCaptureButton.IsEnabled = ready && _tools is not null;
+        ReadCaptureButton.IsEnabled = ready && _fileReady && _tools is not null && _lastFile is not null;
+        OpenWiresharkButton.IsEnabled = ready && _fileReady && _tools is not null && _lastFile is not null;
+        CopyCaptureButton.IsEnabled = ready && _evidence is not null;
+    }
+    private void Open_Click(object sender, RoutedEventArgs e)
+    {
+        if (_tools is null || _lastFile is null || !File.Exists(_lastFile) || !File.Exists(_tools.Wireshark)) return;
+        try
+        {
+            var start = new ProcessStartInfo(_tools.Wireshark) { UseShellExecute = false };
+            start.ArgumentList.Add("-r"); start.ArgumentList.Add(_lastFile);
+            Process.Start(start)?.Dispose(); // Explicit user action opens a viewer, never a live capture.
+        }
+        catch (Exception ex) { CaptureStatusText.Text = "Apertura non riuscita: " + ex.Message; }
+    }
+    private void Copy_Click(object sender, RoutedEventArgs e)
+    {
+        if (_evidence is null) return;
+        ClipboardText.Copy(this, "CATTURA WIRESHARK / WI-FI\n" + CaptureFileText.Text + "\n" + CaptureSummaryText.Text +
+            "\n" + CaptureStatusText.Text + "\n\n" + GridCopySupport.CaptureTable(CaptureObservationsTable, false) + "\n\n" + _evidence.Note);
+    }
+}
