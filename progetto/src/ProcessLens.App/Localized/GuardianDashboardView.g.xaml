                                    Click="AnalyzeLineage_Click"/>
                            <l10n:LocalizedButton Content="{l10n:Tr B258CFB6DE7AACA7}" Padding="13,5" Margin="0,0,8,0"
                                    Click="UseParent_Click"/>
                            <l10n:LocalizedButton Content="{l10n:Tr 2AB460B010062774}" Padding="13,5"
                                    Click="ExploreChild_Click"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#F0F6FC" BorderBrush="#D7E6F3"
                                BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <local:SelectableText x:Name="LineageRootText" FontSize="14" FontWeight="SemiBold"
                                           Text="{l10n:Tr 69FB97864512E5F1}" TextWrapping="Wrap"/>
                                <local:SelectableText x:Name="LineageStatusText" Foreground="#475569" FontSize="11"
                                           Text="{l10n:Tr 3DC8FA6EF36C6ACD}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <local:SelectableText Grid.Row="2" Text="{l10n:Tr 3068F3859E948BCA}"
                                   Foreground="#8A520B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.55*"/></Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <l10n:LocalizedTextBlock Text="{l10n:Tr D7A37D3E7085C80E}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>
                                <DataGrid local:GridCopySupport.Enabled="True" x:Name="LineageAncestorsTable" Grid.Row="1" Style="{StaticResource GuardianTable}">
                                    <DataGrid.Columns>
                                        <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 0E9DE086B15F1FCB}" Binding="{Binding Level}" Width="42"/>
                                        <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 3F302A2A7158A024}" Binding="{Binding Pid}" Width="75"/>
                                        <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 5086900635FEC3EF}" Binding="{Binding Name}" Width="*"/>
                                        <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 5D788017BFE473FD}" Binding="{Binding LinkStatus}" Width="100"/>
                                        <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr F5D5EE3EDADC1583}" Binding="{Binding Evidence}" Width="1.5*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <l10n:LocalizedTextBlock Text="{l10n:Tr 8308203A16DC2D4A}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>
                                <DataGrid local:GridCopySupport.Enabled="True" x:Name="LineageChildrenTable" Grid.Row="1" Style="{StaticResource GuardianTable}"
                                          MouseDoubleClick="LineageChildrenTable_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 050E87566E64C1B2}" Binding="{Binding StartLocal}" Width="148"/>
                                        <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 3F302A2A7158A024}" Binding="{Binding Pid}" Width="64"/>
                                        <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 2C6CF92BAF0E994C}" Binding="{Binding Name}" Width="*"/>
                                        <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 5D788017BFE473FD}" Binding="{Binding LinkStatus}" Width="105"/>
                                        <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr F5D5EE3EDADC1583}" Binding="{Binding Evidence}" Width="1.65*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                        <local:SelectableText Grid.Row="4" x:Name="LineageCoverageText" Foreground="#64748B"
                                   FontSize="11" Text="{l10n:Tr 2F7C12404D27026A}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </Grid>
                </l10n:LocalizedTabItem>
                <l10n:LocalizedTabItem Header="{l10n:Tr 1E6C8132DF04E923}">
                    <Grid Margin="6,12,6,6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <l10n:LocalizedTextBlock Text="{l10n:Tr 9D18C7A31CD5E545}" FontWeight="SemiBold" Foreground="#475569" Margin="4,0,0,10"/>
                        <DataGrid local:GridCopySupport.Enabled="True" x:Name="ResourcesTable" Grid.Row="1" Style="{StaticResource GuardianTable}">
