index 0000000..6936e15
--- /dev/null
+++ b/progetto/src/ProcessLens.Core/LiveMemorySample.cs
@@ -0,0 +1,34 @@
+namespace ProcessLens.Core;
+
+/// <summary>Resident memory and commit read from the same process handle, with its creation time.</summary>
+public sealed record LiveMemorySample(int Pid, DateTime? StartUtc, long WorkingSetBytes,
+    bool WorkingSetAvailable, long PrivateWorkingSetBytes, bool PrivateWorkingSetAvailable,
+    long PrivateCommitBytes, bool PrivateCommitAvailable, double CapturedAtMonotonicSeconds, DateTime CapturedUtc)
+{
+    public bool Matches(ProcessSnapshot p) => p.Pid == Pid && StartUtc.HasValue &&
+        p.StartTime.HasValue && StartUtc.Value == p.StartTime.Value.ToUniversalTime();
+    public bool IsFresh(double now) => double.IsFinite(now) && double.IsFinite(CapturedAtMonotonicSeconds) &&
+        now - CapturedAtMonotonicSeconds is >= 0 and <= CpuIntervalTracker.MaximumGapSeconds;
+    public ProcessSnapshot Apply(ProcessSnapshot p)
+    {
+        if (!Matches(p)) return Unavailable(p);
+        if (p.MemorySampledAtMonotonicSeconds > CapturedAtMonotonicSeconds) return p;
+        bool ws = WorkingSetAvailable && WorkingSetBytes >= 0;
+        bool privateWs = PrivateWorkingSetAvailable && ws && PrivateWorkingSetBytes >= 0 && PrivateWorkingSetBytes <= WorkingSetBytes;
+        bool commit = PrivateCommitAvailable && PrivateCommitBytes >= 0;
+        return p with
+        {
+            WorkingSetBytes = ws ? WorkingSetBytes : 0, WorkingSetAvailable = ws,
+            PrivateWorkingSetBytes = privateWs ? PrivateWorkingSetBytes : 0, PrivateWorkingSetAvailable = privateWs,
+            PrivateBytes = commit ? PrivateCommitBytes : 0, PrivateCommitAvailable = commit,
+            MemorySampledAtMonotonicSeconds = CapturedAtMonotonicSeconds, MemorySampledUtc = CapturedUtc
+        };
+    }
+    public static ProcessSnapshot Unavailable(ProcessSnapshot p) => p with
+    {
+        WorkingSetBytes = 0, WorkingSetAvailable = false,
+        PrivateWorkingSetBytes = 0, PrivateWorkingSetAvailable = false,
+        PrivateBytes = 0, PrivateCommitAvailable = false,
+        MemorySampledAtMonotonicSeconds = 0, MemorySampledUtc = null
+    };
+}
