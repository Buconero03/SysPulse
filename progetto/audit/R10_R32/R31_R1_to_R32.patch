diff --git a/progetto/src/ProcessLens.App/ProcessIconPlaceholder.cs b/progetto/src/ProcessLens.App/ProcessIconPlaceholder.cs
new file mode 100644
index 0000000..ca33e92
--- /dev/null
+++ b/progetto/src/ProcessLens.App/ProcessIconPlaceholder.cs
@@ -0,0 +1,23 @@
+namespace ProcessLens.App;
+
+// A visual placeholder derived from the observed filename, never a claimed product logo.
+internal static class ProcessIconPlaceholder
+{
+    internal static string Key(string? name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim().ToUpperInvariant();
+    internal static string Initials(string? name)
+    {
+        string text = Key(name);
+        if (text.EndsWith(".EXE", StringComparison.Ordinal)) text = text[..^4];
+        var words = text.Split(new[] { ' ', '.', '-', '_' }, StringSplitOptions.RemoveEmptyEntries);
+        var first = words.Select(w => w.FirstOrDefault(char.IsAsciiLetterOrDigit)).Where(c => c != '\0').Take(2).ToArray();
+        if (first.Length == 0) return "?";
+        if (first.Length == 1) return new string(words[0].Where(char.IsAsciiLetterOrDigit).Take(2).ToArray());
+        return new string(first);
+    }
+    internal static int ColorIndex(string? name)
+    {
+        uint hash = 2166136261;
+        foreach (char c in Key(name)) hash = unchecked((hash ^ c) * 16777619);
+        return (int)(hash % 8);
+    }
+}
