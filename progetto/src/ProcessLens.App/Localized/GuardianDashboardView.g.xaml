                    <Grid Margin="6,12,6,6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <l10n:LocalizedTextBlock Text="{l10n:Tr E70D032A78F5871B}" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,12,0"/>
                            <l10n:LocalizedTextBox x:Name="EventSearchBox" Width="270" Height="30" VerticalContentAlignment="Center"
                                     Padding="7,4" TextChanged="EventSearchBox_TextChanged"/>
                            <local:SelectableText x:Name="EventCountText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#64748B"/>
                        </DockPanel>
                        <DataGrid local:GridCopySupport.Enabled="True" x:Name="EventsTable" Grid.Row="1" Style="{StaticResource GuardianTable}" SelectionMode="Single">
                            <DataGrid.Columns>
                                <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 4926B5A86FD65D5D}" Binding="{Binding LocalTime}" Width="170"/>
                                <l10n:LocalizedDataGridTextColumn Header="{l10n:Tr 2C6CF92BAF0E994C}" Binding="{Binding Name}" Width="*"/>
