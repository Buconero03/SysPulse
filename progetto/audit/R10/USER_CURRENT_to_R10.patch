++            if (watch is not null) watch.Dispose(); else handle.Dispose();
++            return null;
++        }
++    }
++
++    public void Dispose()
++    {
++        if (Interlocked.Exchange(ref _disposed, 1) != 0) return;
++        _registration?.Unregister(null);
++        _handle.Dispose();
++    }
